DATABASE_URL="postgresql://postgres:postgres@localhost:5432/InfoCliente?schema=public"
# Obrigatório. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Valores como "change-me" ou strings curtas são recusados no arranque.
JWT_SECRET=
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"

# Opcional — só para criar o PRIMEIRO admin (omitir em produção se o admin já existir).
# Senha: mínimo 12 caracteres; "admin123" é recusado.
# BOOTSTRAP_ADMIN_EMAIL=admin@suaempresa.local
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrador
