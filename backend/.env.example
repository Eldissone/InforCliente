DATABASE_URL="postgresql://postgres:postgres@localhost:5432/InfoCliente?schema=public"
# Obrigatório. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Valores como "change-me" ou strings curtas são recusados no arranque.
JWT_SECRET=
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"

# Opcional — só para criar o PRIMEIRO admin (omitir em produção se o admin já existir).
# Senha: mínimo 12 caracteres; "admin123" é recusado.
# Opcional. Caminho do pg_dump se o executável não estiver no PATH.
# PG_DUMP_PATH=
# Opcional. Role só de leitura usado pelas cópias. Se vazio, usa DATABASE_URL.
# BACKUP_DATABASE_URL=

# BOOTSTRAP_ADMIN_EMAIL=admin@suaempresa.local
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrador

# Área Financeira — leitura automática de faturas com IA (Google Gemini).
# Opcional. Sem chave, o botão «Ler fatura com IA» fica indisponível mas o resto
# da área financeira funciona normalmente.
# Obtenha a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.8-flash"
