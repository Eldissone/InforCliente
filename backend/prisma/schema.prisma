generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String?
  passwordHash             String
  role                     Role                      @default(leitura)
  createdAt                DateTime                  @default(now())
  clientId                 String?
  profilePic               String?
  items                    Item[]
  client                   Client?                   @relation("PrimaryClient", fields: [clientId], references: [id])
  accounts                 UserClient[]
  assignedProjects         Project[]                 @relation("AssignedUsers")
  dailyPlanTasks           DailyPlanTask[]
  permissions              UserPermission[]
  systemLogs               SystemLog[]
  profile                  UserProfile?
  presence                 UserPresence?
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  messageReads             MessageRead[]
  mentionsReceived         Mention[]                 @relation("MentionsReceived")
  notifications            Notification[]
  notificationPreference   UserNotificationPreference?
  aiRequests               AiRequestLog[]
  aiConversations          AiConversation[]
  aiDigests                AiDigest[]
  permissionAuditLogs      PermissionAuditLog[]
  helpTicketsCreated       HelpTicket[]              @relation("HelpTicketAuthor")
  helpTicketsResolved      HelpTicket[]              @relation("HelpTicketResolver")
  contactsCreated          Contact[]                 @relation("ContactCreatedBy")
  sectorsCreated           Sector[]                  @relation("SectorCreatedBy")
  personnelCreated         Personnel[]               @relation("PersonnelCreatedBy")
  registryImportBatches    RegistryImportBatch[]     @relation("RegistryImportBatchCreatedBy")
  budgetsCreated           Budget[]                  @relation("BudgetCreatedBy")
  baremItemsCreated        BaremItem[]               @relation("BaremCreatedBy")
  baremPriceChanges        BaremPriceHistory[]       @relation("BaremPriceChangedBy")
  companySettingsUpdated   CompanySetting[]          @relation("CompanySettingUpdatedBy")
  proposalsCreated         Proposal[]                @relation("ProposalCreatedBy")
  proposalsSent            Proposal[]                @relation("ProposalSentBy")
  requisitionsRequested    MaterialRequisition[]     @relation("RequisitionRequestedBy")
  requisitionsApproved     MaterialRequisition[]     @relation("RequisitionApprovedBy")

  @@index([clientId])
}

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  phone                String?
  whatsapp             String?
  jobTitle             String?
  bio                  String?
  isFinancialReceiver  Boolean  @default(false)
  isApprover           Boolean  @default(false)
  isProjectResponsible Boolean  @default(false)
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
}

model UserPresence {
  userId     String         @id
  status     PresenceStatus @default(OFFLINE)
  lastSeenAt DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType          @default(DIRECT)
  title        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  status         MessageStatus       @default(SENT)
  createdAt      DateTime            @default(now())
  editedAt       DateTime?
  /// Resposta do assistente (@IA). senderId = quem perguntou.
  aiGenerated    Boolean             @default(false)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation("MessageSender", fields: [senderId], references: [id])
  reads          MessageRead[]
  mentions       Mention[]
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Mention {
  id              String  @id @default(cuid())
  messageId       String
  mentionedUserId String
  message         Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser   User    @relation("MentionsReceived", fields: [mentionedUserId], references: [id])

  @@index([mentionedUserId])
}

enum NotificationType {
  NEW_MESSAGE
  MENTION
  REQUEST
  APPROVAL
  SYSTEM
  PAYMENT
  DAILY_PLAN
  STOCK
  DEADLINE
  AI_INSIGHT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  metadata  Json?
  /// Prioridade define o som/destaque no frontend (URGENT = alarme).
  priority   NotificationPriority @default(NORMAL)
  /// Obra a que a notificação diz respeito (filtros e silenciar por obra).
  projectId  String?
  /// Notificações com o mesmo groupKey, não lidas e próximas no tempo, são
  /// fundidas numa só (groupCount conta as ocorrências; createdAt = última).
  groupKey   String?
  groupCount Int                  @default(1)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([userId, groupKey])
  @@index([projectId])
}

/// Preferências de alertas por utilizador (som, avisos do sistema, horário
/// de não incomodar, tipos e obras silenciados). Silenciar não esconde a
/// notificação do centro de notificações — só tira o som e o aviso.
model UserNotificationPreference {
  userId          String   @id
  soundEnabled    Boolean  @default(true)
  volume          Float    @default(0.6)
  desktopEnabled  Boolean  @default(false)
  dndEnabled      Boolean  @default(false)
  dndFrom         String   @default("22:00")
  dndTo           String   @default("07:00")
  mutedTypes      Json     @default("[]")
  mutedProjectIds Json     @default("[]")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  fileName  String
  mimeType  String
  size      Int
  path      String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model UserClient {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  role      Role     @default(leitura)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

model Client {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  industry     String?
  region       String?
  tier         String?
  status       ClientStatus       @default(ACTIVE)
  healthScore  Int                @default(50)
  ltvTotal     Decimal            @db.Decimal(14, 2)
  churnRisk    Decimal            @db.Decimal(5, 2)
  ltvPotential Decimal            @db.Decimal(14, 2)
  profilePic   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  alerts       Alert[]
  tags         ClientTag[]
  interactions InteractionEvent[]
  projects     Project[]
  primaryUsers User[]             @relation("PrimaryClient")
  users        UserClient[]
  invoices     Invoice[]
  budgets      Budget[]

  @@index([name])
  @@index([status])
}

model ClientTag {
  id       String @id @default(cuid())
  clientId String
  tag      String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, tag])
}

model Project {
  id                  String                   @id @default(cuid())
  code                String                   @unique
  name                String
  location            String?
  region              String?
  status              ProjectStatus            @default(ACTIVE)
  active              Boolean                  @default(true)
  startDate           DateTime?
  dueDate             DateTime?
  launchDate          DateTime?
  actualEndDate       DateTime?
  budgetTotal         Decimal                  @db.Decimal(16, 2)
  budgetAllocated     Decimal                  @db.Decimal(16, 2)
  budgetConsumed      Decimal                  @db.Decimal(16, 2)
  budgetCommitted     Decimal                  @db.Decimal(16, 2)
  budgetAvailable     Decimal                  @db.Decimal(16, 2)
  budgetVersion       Int                      @default(1)
  physicalProgressPct Float                    @default(0)
  currency            String?                  @default("AOA")
  phaseLabel          String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  clientId            String?
  contact             String?
  projectType         String?
  empreiteiro         String?
  subempreiteiro      String?
  directorObra        String?
  directorPhoto       String?
  directorPhone       String?
  directorEmail       String?
  technicians         Json?                    @default("[]")
  referencia          String?
  lastAccidentDate    DateTime?
  activeStaffCount    Int?                     @default(0)
  safetyHistory       Json?
  maoDeObraIndireta   Json?
  maoDeObraDireta     Json?
  equipamentos        Json?
  alerts              Alert[]
  client              Client?                  @relation(fields: [clientId], references: [id])
  budgetLines         ProjectBudgetLine[]
  files               ProjectFile[]
  folders             ProjectFolder[]
  payments            ProjectPayment[]
  photos              ProjectPhoto[]
  safetyObservations  SafetyObservation[]
  progressHistory     ProjectProgressHistory[]
  progressTasks       ProjectProgressTask[]
  measurementReports  MeasurementReport[]
  transactions        ProjectTransaction[]
  stockMovements      StockMovement[]
  warehouses          Warehouse[]
  assignedUsers       User[]                   @relation("AssignedUsers")
  dailyPlans          DailyPlan[]
  materialPlans       ProjectMaterialPlan[]
  costCenters         CostCenter[]
  workNeeds           WorkNeed[]
  costPayments        CostPayment[]
  pettyCashFunds      PettyCashFund[]
  extraRequests       ExtraRequest[]
  freightAllocations  FreightAllocation[]
  purchaseOrders      PurchaseOrder[]
  quoteSupplierOrders QuoteSupplierOrder[]
  personnel           Personnel[]
  personnelAssignments PersonnelProject[]
  pauses              ProjectPause[]
  projectContacts     ProjectContact[]
  invoices            Invoice[]
  bankMovements       BankMovement[]
  notifications       Notification[]
  materialRequisitions MaterialRequisition[]
  aiExclusion         AiDataExclusion?
  aiConversations     AiConversation[]
  /// Orçamento que originou esta obra (adjudicação)
  sourceBudget        Budget?

  // ─── Configuração de faturação da obra (Área Financeira) ───
  billingVatCativo          Boolean @default(false) // IVA cativo: recebimento não considera IVA
  billingVatPercent         Decimal? @db.Decimal(5, 2) // % IVA aplicada
  billingWithholdingPercent Decimal? @db.Decimal(5, 2) // % Retenção na Fonte
  billingCarPercent         Decimal? @db.Decimal(5, 2) // % Seguro CAR
  billingGuaranteePercent   Decimal? @db.Decimal(5, 2) // % Garantia

  @@index([name])
  @@index([status])
}

model ProjectPause {
  id        String   @id @default(cuid())
  projectId String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startDate])
}

model ProjectContact {
  id        String   @id @default(cuid())
  projectId String
  contactId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([projectId, contactId])
  @@index([contactId])
}

model ProjectFolder {
  id        String          @id @default(cuid())
  name      String
  projectId String
  parentId  String?
  createdAt DateTime        @default(now())
  files     ProjectFile[]
  parent    ProjectFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFolder[] @relation("FolderChildren")
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, parentId, createdAt])
}

model ProjectFile {
  id           String         @id @default(cuid())
  projectId    String
  originalName String
  mimeType     String
  size         Int
  path         String
  category     String?        @default("OUTROS")
  createdAt    DateTime       @default(now())
  folderId     String?
  folder       ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectBudgetLine {
  id           String               @id @default(cuid())
  projectId    String
  version      Int                  @default(1)
  rowNumber    Int?
  sourceFile   String?
  category     String?
  description  String
  unit         String?
  quantity     Decimal?             @db.Decimal(16, 4)
  unitPrice    Decimal?             @db.Decimal(16, 4)
  total        Decimal              @db.Decimal(16, 2)
  createdAt    DateTime             @default(now())
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions ProjectTransaction[]
  workNeeds    WorkNeed[]

  @@index([projectId, createdAt])
  @@index([projectId, version])
}

model ProjectTransaction {
  id             String              @id @default(cuid())
  projectId      String
  date           DateTime
  description    String
  category       TransactionCategory @default(OTHER)
  ownerName      String?
  status         TransactionStatus   @default(PENDING)
  amount         Decimal             @db.Decimal(16, 2)
  realizedAmount Decimal?            @db.Decimal(16, 2)
  budgetLineId   String?
  currency       String?

  // Novos campos: Centro de Custo, Fornecedor, Tipo Pagamento
  costCenterId String?
  supplier     String?
  paymentType  String? @default("PRONTO_PAGAMENTO")

  budgetLine ProjectBudgetLine? @relation(fields: [budgetLineId], references: [id])
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenter CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([costCenterId])
}

model InteractionEvent {
  id          String   @id @default(cuid())
  clientId    String
  type        String
  title       String
  description String?
  occurredAt  DateTime
  leadName    String?
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt])
}

model Alert {
  id        String        @id @default(cuid())
  severity  AlertSeverity @default(MEDIUM)
  status    AlertStatus   @default(OPEN)
  title     String
  body      String?
  createdAt DateTime      @default(now())
  clientId  String?
  projectId String?
  /// Alertas da IA (Fase 3.2): CHAIN_DELAY | MATERIAL_SHORTAGE | STALLED_NEED | BUDGET_OVERRUN
  kind          String?
  /// Identifica a situação (ex.: "MATERIAL_SHORTAGE:obra:produto") para não repetir o alerta.
  fingerprint   String?   @unique
  /// Factos do sistema que deram origem ao alerta.
  metadata      Json?
  /// Explicação/sugestão escrita pela IA a partir dos factos (opcional).
  aiExplanation String?
  /// Interno: nunca mostrado a utilizadores com perfil cliente.
  internal      Boolean   @default(false)
  lastSeenAt    DateTime?
  resolvedAt    DateTime?
  /// Gravidade com que o alerta já foi enviado como urgente (evita repetir).
  notifiedSeverity String?
  client    Client?       @relation(fields: [clientId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id])

  @@index([status, severity, createdAt])
  @@index([projectId, status])
}

model ProjectProgressTask {
  id                String                   @id @default(cuid())
  projectId         String
  itemGroup         String?
  wbsCode           String?
  parentId          String?
  order             Int                      @default(0)
  description       String
  expectedQty       Decimal                  @db.Decimal(18, 10)
  executedQty       Decimal                  @default(0) @db.Decimal(18, 10)
  unit              String
  unitValue         Decimal?                 @db.Decimal(18, 8)
  unitValueMaterial Decimal?                 @db.Decimal(18, 8)
  unitValueService  Decimal?                 @db.Decimal(18, 8)
  totalValue        Decimal?                 @db.Decimal(18, 8)
  currency          String?                  @default("AOA")
  createdAt         DateTime                 @default(now())
  history           ProjectProgressHistory[]
  parent            ProjectProgressTask?     @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks          ProjectProgressTask[]    @relation("SubTasks")
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyPlanTasks    DailyPlanTask[]

  @@index([projectId, itemGroup, order])
}

model ProjectProgressHistory {
  id             String              @id @default(cuid())
  projectId      String
  taskId         String
  date           DateTime            @default(now())
  executedQty    Decimal             @db.Decimal(18, 10)
  accumulatedQty Decimal             @db.Decimal(18, 10)
  technicianName String?
  notes          String?
  createdAt      DateTime            @default(now())
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           ProjectProgressTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, taskId, date])
}

model MeasurementReport {
  id             String    @id @default(cuid())
  projectId      String
  reportNumber   String
  reportDate     DateTime
  prevDate       DateTime?
  status         String    @default("DRAFT")
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  snapshotData   Json?
  periodQtyTotal Decimal?  @db.Decimal(18, 2)
  periodValTotal Decimal?  @db.Decimal(18, 2)
  createdAt      DateTime  @default(now())
  createdBy      String?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@unique([projectId, reportNumber])
  @@index([projectId, reportDate])
}

model ProjectPayment {
  id               String        @id @default(cuid())
  projectId        String
  valor            Decimal       @db.Decimal(16, 2)
  dataPagamento    DateTime
  metodo           String?
  referencia       String?
  comprovativoPath String?
  criadoPor        String?
  status           PaymentStatus @default(PENDENTE)
  createdAt        DateTime      @default(now())
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, dataPagamento])
}

model Warehouse {
  id              String           @id @default(cuid())
  name            String
  type            WarehouseType    @default(CENTRAL)
  active          Boolean          @default(true)
  visibleToClient Boolean          @default(false)
  projectId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           Item[]
  targetItems     Item[]           @relation("ItemTargetWarehouse")
  movements       StockMovement[]
  project         Project?         @relation(fields: [projectId], references: [id])
  stock           WarehouseStock[]
  requisitionsFrom MaterialRequisition[] @relation("RequisitionSourceWarehouse")
  requisitionsTo   MaterialRequisition[] @relation("RequisitionTargetWarehouse")

  @@index([projectId])
}

model Product {
  id                 String                @id @default(cuid())
  sku                String?               @unique
  barcode            String?               @unique
  name               String
  description        String?
  image              String?
  category           ProductCategory       @default(MATERIAL)
  unit               ProductUnit           @default(UN)
  minStock           Decimal               @default(0) @db.Decimal(16, 4)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  items              Item[]
  movements          StockMovement[]
  stock              WarehouseStock[]
  dailyPlanMaterials DailyPlanMaterial[]
  projectPlans       ProjectMaterialPlan[]
  aliases            ProductAlias[]
  supplierProducts   SupplierProduct[]
  requisitionItems   MaterialRequisitionItem[]
}

model ProductAlias {
  id          String   @id @default(cuid())
  productId   String
  alias       String
  normalized  String   @unique
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  ownerId     String?
  quantity    Decimal   @default(0) @db.Decimal(16, 4)
  /// Custo medio ponderado deste produto NESTE armazem, mantido a cada entrada.
  /// O custo da obra nasce na saida, a este valor.
  avgCost     Decimal?  @db.Decimal(16, 4)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, ownerId])
}

model Item {
  id                String     @id @default(cuid())
  serialNumber      String?    @unique
  internalTag       String?    @unique
  productId         String
  warehouseId       String?
  targetWarehouseId String?
  projectId         String?
  responsibleId     String?
  status            ItemStatus @default(AVAILABLE)
  condition         String?    @default("GOOD")
  notes             String?
  lastStatusNote    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  assignedAt        DateTime?
  imageUrl          String?
  returnedAt        DateTime?
  product           Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  responsible       User?      @relation(fields: [responsibleId], references: [id])
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])
  targetWarehouse   Warehouse? @relation("ItemTargetWarehouse", fields: [targetWarehouseId], references: [id])

  @@index([productId])
  @@index([status])
}

model StockMovement {
  id              String         @id @default(cuid())
  projectId       String?
  type            MovementType
  quantity        Decimal        @db.Decimal(16, 4)
  notes           String?
  createdAt       DateTime       @default(now())
  evidenceUrl     String?
  vehicleImageUrl String?
  ownerId         String?
  productId       String
  reference       String?
  sourceQuoteId   String?
  dailyPlanId     String?
  userId          String
  warehouseId     String
  // Saída para a obra = custo da obra: nº da fatura da compra e confirmação do financeiro.
  costDocNumber   String?
  costConfirmedAt DateTime?
  costConfirmedBy String?
  /// Custo unitario usado neste movimento (entrada: o de compra; saida: o custo medio
  /// do armazem no momento). Gravado quando o movimento e feito, para o custo da obra
  /// nao mudar quando o custo medio mudar depois.
  unitCost        Decimal?       @db.Decimal(16, 4)
  totalValue      Decimal?       @db.Decimal(16, 2)
  /// Requisicao de material que originou este movimento, quando ha.
  requisitionId   String?
  photos          ProjectPhoto[]
  product         Product        @relation(fields: [productId], references: [id])
  project         Project?       @relation(fields: [projectId], references: [id])
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  sourceQuote     NeedQuote?     @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  dailyPlan       DailyPlan?     @relation(fields: [dailyPlanId], references: [id], onDelete: SetNull)
  requisition     MaterialRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)

  @@index([sourceQuoteId])
  @@index([dailyPlanId])
  @@index([projectId, productId, warehouseId])
}

model ProjectPhoto {
  id          String         @id @default(cuid())
  projectId   String
  movementId  String?
  path        String
  lat         Decimal?       @db.Decimal(10, 8)
  lng         Decimal?       @db.Decimal(11, 8)
  takenAt     DateTime?
  description String?
  createdAt   DateTime       @default(now())
  itemId      String?
  /// Tarefa WBS a que a foto foi associada (sugerida pela IA e confirmada por uma pessoa).
  progressTaskId String?
  /// Última análise da IA: { caption, taskId, taskConfidence, risks[], ppe, model }.
  aiAnalysis     Json?
  aiAnalyzedAt   DateTime?
  movement    StockMovement? @relation(fields: [movementId], references: [id])
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  safetyObservations SafetyObservation[]
}

/// Histórico de segurança da obra (Fase 3.5). Os riscos vistos pela IA nas fotos
/// ficam SUGGESTED até uma pessoa os confirmar ou descartar.
model SafetyObservation {
  id          String        @id @default(cuid())
  projectId   String
  photoId     String?
  /// AI_PHOTO | MANUAL
  source      String        @default("AI_PHOTO")
  /// PPE (EPI) | FALL (queda em altura) | HOUSEKEEPING (arrumação) | MACHINERY | ELECTRICAL | EXCAVATION | OTHER
  category    String
  severity    AlertSeverity @default(MEDIUM)
  description String
  /// SUGGESTED | CONFIRMED | DISMISSED | RESOLVED
  status      String        @default("SUGGESTED")
  reviewedById   String?
  reviewedByName String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime      @default(now())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photo       ProjectPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([photoId])
}

model RolePermission {
  id      String @id @default(cuid())
  role    String
  module  String
  action  String
  allowed String

  @@unique([role, module, action])
  @@index([role])
  @@map("role_permissions")
}

/// Overrides de permissão por utilizador (prevalece sobre o perfil/role)
model UserPermission {
  id      String @id @default(cuid())
  userId  String
  module  String
  action  String
  allowed String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, action])
  @@index([userId])
  @@map("user_permissions")
}

model PermissionAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  targetType  String? // "role" or "user"
  targetId    String? // role name or user id
  role        String?
  module      String?
  action      String?
  beforeValue String?
  afterValue  String?
  reason      String?
  context     Json?
  createdAt   DateTime @default(now())

  actorUser User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("permission_audit_logs")
}

