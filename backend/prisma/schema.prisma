generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  passwordHash     String
  role             Role         @default(leitura)
  createdAt        DateTime     @default(now())
  clientId         String?
  profilePic       String?
  items            Item[]
  client           Client?      @relation("PrimaryClient", fields: [clientId], references: [id])
  accounts         UserClient[]
  assignedProjects Project[]    @relation("AssignedUsers")

  @@index([clientId])
}

model UserClient {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  role      Role     @default(leitura)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

model Client {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  industry     String?
  region       String?
  tier         String?
  status       ClientStatus       @default(ACTIVE)
  healthScore  Int                @default(50)
  ltvTotal     Decimal            @db.Decimal(14, 2)
  churnRisk    Decimal            @db.Decimal(5, 2)
  ltvPotential Decimal            @db.Decimal(14, 2)
  profilePic   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  alerts       Alert[]
  tags         ClientTag[]
  interactions InteractionEvent[]
  projects     Project[]
  primaryUsers User[]             @relation("PrimaryClient")
  users        UserClient[]

  @@index([name])
  @@index([status])
}

model ClientTag {
  id       String @id @default(cuid())
  clientId String
  tag      String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, tag])
}

model Project {
  id                  String                   @id @default(cuid())
  code                String                   @unique
  name                String
  location            String?
  region              String?
  status              ProjectStatus            @default(ACTIVE)
  active              Boolean                  @default(true)
  startDate           DateTime?
  dueDate             DateTime?
  budgetTotal         Decimal                  @db.Decimal(16, 2)
  budgetAllocated     Decimal                  @db.Decimal(16, 2)
  budgetConsumed      Decimal                  @db.Decimal(16, 2)
  budgetCommitted     Decimal                  @db.Decimal(16, 2)
  budgetAvailable     Decimal                  @db.Decimal(16, 2)
  physicalProgressPct Float                    @default(0)
  currency            String?                  @default("AOA")
  phaseLabel          String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  clientId            String?
  contact             String?
  projectType         String?
  empreiteiro         String?
  subempreiteiro      String?
  directorObra        String?
  directorPhoto       String?
  directorPhone       String?
  directorEmail       String?
  technicians         Json?                    @default("[]")
  referencia          String?
  lastAccidentDate    DateTime?
  activeStaffCount    Int?                     @default(0)
  safetyHistory       Json?
  maoDeObraIndireta   Json?
  maoDeObraDireta     Json?
  equipamentos        Json?
  alerts              Alert[]
  client              Client?                  @relation(fields: [clientId], references: [id])
  budgetLines         ProjectBudgetLine[]
  files               ProjectFile[]
  folders             ProjectFolder[]
  payments            ProjectPayment[]
  photos              ProjectPhoto[]
  progressHistory     ProjectProgressHistory[]
  progressTasks       ProjectProgressTask[]
  transactions        ProjectTransaction[]
  stockMovements      StockMovement[]
  warehouse           Warehouse?
  assignedUsers       User[]                   @relation("AssignedUsers")

  @@index([name])
  @@index([status])
}

model ProjectFolder {
  id        String          @id @default(cuid())
  name      String
  projectId String
  parentId  String?
  createdAt DateTime        @default(now())
  files     ProjectFile[]
  parent    ProjectFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFolder[] @relation("FolderChildren")
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, parentId, createdAt])
}

model ProjectFile {
  id           String         @id @default(cuid())
  projectId    String
  originalName String
  mimeType     String
  size         Int
  path         String
  category     String?        @default("OUTROS")
  createdAt    DateTime       @default(now())
  folderId     String?
  folder       ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectBudgetLine {
  id           String               @id @default(cuid())
  projectId    String
  rowNumber    Int?
  sourceFile   String?
  category     String?
  description  String
  unit         String?
  quantity     Decimal?             @db.Decimal(16, 4)
  unitPrice    Decimal?             @db.Decimal(16, 4)
  total        Decimal              @db.Decimal(16, 2)
  createdAt    DateTime             @default(now())
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions ProjectTransaction[]

  @@index([projectId, createdAt])
}

model ProjectTransaction {
  id             String              @id @default(cuid())
  projectId      String
  date           DateTime
  description    String
  category       TransactionCategory @default(OTHER)
  ownerName      String?
  status         TransactionStatus   @default(PENDING)
  amount         Decimal             @db.Decimal(16, 2)
  realizedAmount Decimal?            @db.Decimal(16, 2)
  budgetLineId   String?
  budgetLine     ProjectBudgetLine?  @relation(fields: [budgetLineId], references: [id])
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
}

model InteractionEvent {
  id          String   @id @default(cuid())
  clientId    String
  type        String
  title       String
  description String?
  occurredAt  DateTime
  leadName    String?
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt])
}

model Alert {
  id        String        @id @default(cuid())
  severity  AlertSeverity @default(MEDIUM)
  status    AlertStatus   @default(OPEN)
  title     String
  body      String?
  createdAt DateTime      @default(now())
  clientId  String?
  projectId String?
  client    Client?       @relation(fields: [clientId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id])

  @@index([status, severity, createdAt])
}

model ProjectProgressTask {
  id                String                   @id @default(cuid())
  projectId         String
  itemGroup         String?
  parentId          String?
  order             Int                      @default(0)
  description       String
  expectedQty       Decimal                  @db.Decimal(18, 10)
  executedQty       Decimal                  @default(0) @db.Decimal(18, 10)
  unit              String
  unitValue         Decimal?                 @db.Decimal(18, 8)
  unitValueMaterial Decimal?                 @db.Decimal(18, 8)
  unitValueService  Decimal?                 @db.Decimal(18, 8)
  totalValue        Decimal?                 @db.Decimal(18, 8)
  currency          String?                  @default("AOA")
  createdAt         DateTime                 @default(now())
  history           ProjectProgressHistory[]
  parent            ProjectProgressTask?     @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks          ProjectProgressTask[]    @relation("SubTasks")
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, itemGroup, order])
}

model ProjectProgressHistory {
  id             String              @id @default(cuid())
  projectId      String
  taskId         String
  date           DateTime            @default(now())
  executedQty    Decimal             @db.Decimal(18, 10)
  accumulatedQty Decimal             @db.Decimal(18, 10)
  technicianName String?
  notes          String?
  createdAt      DateTime            @default(now())
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           ProjectProgressTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, taskId, date])
}

model ProjectPayment {
  id               String        @id @default(cuid())
  projectId        String
  valor            Decimal       @db.Decimal(16, 2)
  dataPagamento    DateTime
  metodo           String?
  referencia       String?
  comprovativoPath String?
  criadoPor        String?
  status           PaymentStatus @default(PENDENTE)
  createdAt        DateTime      @default(now())
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, dataPagamento])
}

model Warehouse {
  id        String           @id @default(cuid())
  name      String
  type      WarehouseType    @default(CENTRAL)
  active    Boolean          @default(true)
  projectId String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items       Item[]
  targetItems Item[]           @relation("ItemTargetWarehouse")
  movements   StockMovement[]
  project     Project?         @relation(fields: [projectId], references: [id])
  stock       WarehouseStock[]
}

model Product {
  id          String           @id @default(cuid())
  sku         String?          @unique
  barcode     String?          @unique
  name        String
  description String?
  image       String?
  category    ProductCategory  @default(MATERIAL)
  unit        ProductUnit      @default(UN)
  minStock    Decimal          @default(0) @db.Decimal(16, 4)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       Item[]
  movements   StockMovement[]
  stock       WarehouseStock[]
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  ownerId     String?
  quantity    Decimal   @default(0) @db.Decimal(16, 4)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, ownerId])
}

model Item {
  id            String     @id @default(cuid())
  serialNumber  String?    @unique
  internalTag   String?    @unique
  productId     String
  warehouseId      String?
  targetWarehouseId String?
  projectId        String?
  responsibleId    String?
  status           ItemStatus @default(AVAILABLE)
  condition        String?    @default("GOOD")
  notes            String?
  lastStatusNote   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  assignedAt       DateTime?
  imageUrl         String?
  returnedAt       DateTime?
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  responsible      User?      @relation(fields: [responsibleId], references: [id])
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  targetWarehouse  Warehouse? @relation("ItemTargetWarehouse", fields: [targetWarehouseId], references: [id])

  @@index([productId])
  @@index([status])
}

model StockMovement {
  id          String         @id @default(cuid())
  projectId   String?
  type        MovementType
  quantity    Decimal        @db.Decimal(16, 4)
  notes       String?
  createdAt   DateTime       @default(now())
  evidenceUrl String?
  ownerId     String?
  productId   String
  reference   String?
  userId      String
  warehouseId String
  photos      ProjectPhoto[]
  product     Product        @relation(fields: [productId], references: [id])
  project     Project?       @relation(fields: [projectId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
}

model ProjectPhoto {
  id          String         @id @default(cuid())
  projectId   String
  movementId  String?
  path        String
  lat         Decimal?       @db.Decimal(10, 8)
  lng         Decimal?       @db.Decimal(11, 8)
  takenAt     DateTime?
  description String?
  createdAt   DateTime       @default(now())
  itemId      String?
  movement    StockMovement? @relation(fields: [movementId], references: [id])
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RolePermission {
  id      String @id @default(cuid())
  role    String
  module  String
  action  String
  allowed String

  @@unique([role, module, action])
  @@index([role])
  @@map("role_permissions")
}

enum WarehouseType {
  CENTRAL
  SITE
  CLIENT
}

enum ProductCategory {
  MATERIAL
  TOOL
  EQUIPMENT
  CONSUMABLE
}

enum ProductUnit {
  UN
  KG
  M
  L
  CX
  PAR
  MT2
  MT3
}

enum ItemStatus {
  AVAILABLE
  PENDING_RECEIPT
  ASSIGNED
  PENDING_RETURN
  MAINTENANCE
  BROKEN
  LOST
  RETIRED
}

enum MovementType {
  ENTRY
  EXIT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  LOSS
}

enum Role {
  admin
  operador
  leitura
  cliente
}

enum ClientStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TransactionCategory {
  MATERIALS
  EQUIPMENT
  LABOR
  OTHER
  MATERIAIS_INSUMOS
  SERVICOS_MAO_DE_OBRA
  GASTOS_PESSOAL
  DESPESAS_OPERACIONAIS
  INVESTIMENTOS
  DEPRECIACAO
  OUTRAS_DESPESAS
  DEDUCOES
  IMPOSTOS
}

enum TransactionStatus {
  PAID
  PENDING
  LATE
}

enum AlertSeverity {
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACK
}

enum PaymentStatus {
  CONFIRMADO
  PENDENTE
}
