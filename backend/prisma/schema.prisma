}

model DailyPlanMaterial {
  id           String  @id @default(cuid())
  dailyPlanId  String
  productId    String
  requestedQty Decimal @db.Decimal(16, 4)
  providedQty  Decimal @default(0) @db.Decimal(16, 4)
  consumedQty  Decimal @default(0) @db.Decimal(16, 4)

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model ProjectMaterialPlan {
  id         String  @id @default(cuid())
  projectId  String
  productId  String
  plannedQty Decimal @default(0) @db.Decimal(16, 4)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([projectId, productId])
}

// =============================================
// MÓDULO: CENTRO DE CUSTOS
// =============================================

model CostCenter {
  id            String               @id @default(cuid())
  projectId     String
  code          String
  name          String
  currency      String               @default("AOA")
  active        Boolean              @default(true)
  requiresQuotation Boolean          @default(true)
  createdAt     DateTime             @default(now())
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  needs         WorkNeed[]
  materialRequisitions MaterialRequisition[]
  payments      CostPayment[]
  transactions  ProjectTransaction[]
  extraRequests ExtraRequest[]
  freightAllocations FreightAllocation[]
  purchaseOrders PurchaseOrder[]

  @@unique([projectId, code])
  @@index([projectId])
}

model WorkNeed {
  id                String               @id @default(cuid())
  projectId         String?
  costCenterId      String?
  budgetLineId      String?
  date              DateTime             @default(now())
  description       String
  quantity          Decimal?             @db.Decimal(16, 4)
  unit              String?
  unitPrice         Decimal?             @db.Decimal(16, 4)
  originalUnitPrice Decimal?             @db.Decimal(16, 4)
  priceExceptionReason String?
  priceExceptionBy     String?
  priceExceptionAt     DateTime?
  hours             Decimal?             @db.Decimal(16, 4)
  priority          NeedPriority         @default(MEDIA)
  status            NeedStatus           @default(PENDING)
  scheduled         Boolean              @default(false)
  siteReceivedAt    DateTime?
  siteReceivedBy    String?
  siteReceivedNotes String?
  siteReceptionPlannedAt DateTime?
  siteReceptionLocation  String?
  responsible       String?
  notes             String?
  extraRequestId    String?
  purchaseOrderId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  project           Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenter        CostCenter?          @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  budgetLine        ProjectBudgetLine?   @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  extraRequest      ExtraRequest?        @relation(fields: [extraRequestId], references: [id], onDelete: SetNull)
  purchaseOrder     PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  payments          CostPayment[]
  quotes            NeedQuote[]
  installments      PaymentInstallment[]

  @@index([projectId, costCenterId])
  @@index([budgetLineId])
  @@index([extraRequestId])
  @@index([purchaseOrderId])
}

model CostPayment {
  id                 String              @id @default(cuid())
  projectId          String
  costCenterId       String
  needId             String?
  supplierId         String?
  docNumber          String?
  paymentDate        DateTime
  confirmedAt        DateTime?
  supplier           String?
  category           PaymentCategory     @default(MATERIAL)
  description        String
  budgetedAmount     Decimal             @db.Decimal(16, 2)
  paidAmount         Decimal             @db.Decimal(16, 2)
  grossAmount        Decimal?            @db.Decimal(16, 2)
  vatAmount          Decimal?            @db.Decimal(16, 2)
  withholdingAmount  Decimal?            @db.Decimal(16, 2)
  netAmount          Decimal?            @db.Decimal(16, 2)
  fiscalApplyVat         Boolean         @default(false)
  fiscalApplyWithholding Boolean         @default(false)
  fiscalApplyDiscount    Boolean         @default(false)
  fiscalInputMode        String?         // "base" | "gross"
  paymentMethod      String?
  paymentType        String?             @default("PRONTO_PAGAMENTO")
  week               String?
  installment        Int?
  status             CostPayStatus       @default(PENDENTE)
  notes              String?
  comprovativoUrl    String?
  faturaUrl          String?
  certificationStatus CertificationStatus @default(PENDENTE)
  certifiedBy        String?
  certifiedAt        DateTime?
  certificationNotes String?
  confirmationStatus CostConfirmationStatus @default(POR_CONFIRMAR)
  responsible        String?
  sourceType             String? // MERCADORIA_STOCK | PAGAMENTO_DIRETO | ATM | MOVIMENTO_BANCARIO | MANUAL
  bankMovementId         String? // movimento do extrato que originou / reconcilia este custo
  costCategoryId         Int? // categoria/subcategoria do catálogo de custos
  createdAt          DateTime            @default(now())
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenter         CostCenter          @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  need               WorkNeed?           @relation(fields: [needId], references: [id], onDelete: SetNull)
  supplierRef        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentInstallment PaymentInstallment?
  freightOrder       FreightOrder?

  @@index([supplierId])
  @@index([projectId, costCenterId])
  @@index([projectId, paymentDate])
  @@index([confirmedAt])
  @@index([certificationStatus])
  @@index([bankMovementId])
}

// =============================================
// MÓDULO: FUNDO DE MANEIO & PEDIDOS EXTRA (Fase 7/8)
// =============================================

enum FundMovementType {
  CREDITO // reforço de saldo
  DEBITO // utilização (ex.: Pedido Extra)
  AJUSTE // correcção manual auditada
}

enum ExtraRequestType {
  OBRA // vinculado a uma obra específica
  GERAL // sem vínculo obrigatório a uma obra
}

enum ExtraPaymentSource {
  CAIXA
  BANCO
  FUNDO_MANEIO
  SOLICITACAO_TRANSFERENCIA // pedido de transferência bancária (substitui BANCO nos novos pedidos)
  TRANSFERENCIA_INTERNA_CARTAO // transferência interna para carregar cartão (crédito na liquidação)
}

enum ExtraRequestStatus {
  PENDENTE
  APROVADO
  REJEITADO
  PAGO
  CANCELADO
}

// O Fundo de Maneio representa um saldo disponível (não é um custo).
// Pode existir por obra ou, quando projectId é nulo, como fundo geral.
model PettyCashFund {
  id             String   @id @default(cuid())
  projectId      String?
  name           String
  currency       String   @default("AOA")
  initialBalance Decimal  @default(0) @db.Decimal(16, 2)
  currentBalance Decimal  @default(0) @db.Decimal(16, 2)
  active         Boolean  @default(true)
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project               Project?                        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cards                 PettyCashCard[]
  movements             PettyCashMovement[]
  extraRequests         ExtraRequest[]
  reinforcementRequests PettyCashReinforcementRequest[]

  @@index([projectId])
  purchaseOrders PurchaseOrder[]
}

enum PettyCashCardType {
  PREPAGO
  DEBITO
  CREDITO
}

// Cartões associados a um Fundo de Maneio (Cartão 1, Cartão 2...).
// Cada cartão tem saldo próprio — o saldo do fundo é o agregado dos cartões.
model PettyCashCard {
  id               String            @id @default(cuid())
  fundId           String
  label            String
  lastDigits       String?
  // Registo completo do cartão.
  cardNumberMasked String?
  bank             String?
  holderName       String?
  type             PettyCashCardType @default(PREPAGO)
  issuedAt         DateTime?
  expiresAt        DateTime?
  limitAmount      Decimal?          @db.Decimal(16, 2)
  responsibleName  String?
  initialBalance   Decimal           @default(0) @db.Decimal(16, 2)
  currentBalance   Decimal           @default(0) @db.Decimal(16, 2)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())

  fund                  PettyCashFund                   @relation(fields: [fundId], references: [id], onDelete: Cascade)
  movements             PettyCashMovement[]
  extraRequests         ExtraRequest[]
  reinforcementRequests PettyCashReinforcementRequest[]
  bankStatements        BankStatement[]
  bankMovements         BankMovement[]
  bankBalances          BankBalance[]

  @@index([fundId])
}

// Histórico auditável de todas as movimentações de um Fundo de Maneio.
model PettyCashMovement {
  id             String           @id @default(cuid())
  fundId         String
  cardId         String?
  type           FundMovementType
  amount         Decimal          @db.Decimal(16, 2)
  balanceAfter   Decimal          @db.Decimal(16, 2)
  description    String
  extraRequestId String?          @unique
  createdBy      String?
  createdAt      DateTime         @default(now())

  fund                 PettyCashFund                  @relation(fields: [fundId], references: [id], onDelete: Cascade)
  card                 PettyCashCard?                 @relation(fields: [cardId], references: [id], onDelete: SetNull)
  extraRequest         ExtraRequest?                  @relation(fields: [extraRequestId], references: [id], onDelete: SetNull)
  reinforcementRequest PettyCashReinforcementRequest?

  @@index([fundId, createdAt])
  @@index([cardId])
}

enum ReinforcementStatus {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

// Pedido de Reforço de Fundo de Maneio: um reforço só entra em vigor (e só
// se torna um PettyCashMovement CREDITO real) depois de aprovado. Enquanto
// pendente, não altera nenhum saldo — espelha o fluxo de ExtraRequest, mas
// na direção contrária (entrada de fundo, não saída).
model PettyCashReinforcementRequest {
  id             String              @id @default(cuid())
  fundId         String
  cardId         String?
  amount         Decimal             @db.Decimal(16, 2)
  reason         String
  status         ReinforcementStatus @default(PENDENTE)
  requestedBy    String?
  requestedAt    DateTime            @default(now())
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  movementId     String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  fund     PettyCashFund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  card     PettyCashCard?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  movement PettyCashMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@index([fundId, status])
  @@index([cardId])
}

// Centros de custo gerais (fora do planeamento de obra).
model GeneralCostCenter {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  extraRequests ExtraRequest[]

  @@index([active])
}

enum CostCategoryDomain {
  GERAL
  OBRA
  VIATURAS
}

// Catálogo de tipos de custo / subcustos (CENTRO COMPRAS).
model CostCategory {
  id                   Int                 @id @default(autoincrement())
  code                 String              @unique
  name                 String
  domain               CostCategoryDomain
  parentId             Int?
  level                Int
  sortOrder            Int                 @default(0)
  isSelectable         Boolean             @default(true)
  requiresDetailText   Boolean             @default(false)
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())

  parent        CostCategory?  @relation("CostCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      CostCategory[] @relation("CostCategoryTree")
  extraRequests ExtraRequest[]

  @@index([domain, parentId])
  @@index([active])
}

// Pedido Extra: da Obra (vinculado) ou Geral (sem vínculo obrigatório).
// Pode ser pago via Caixa, Banco ou débito num Fundo de Maneio.
model ExtraRequest {
  id                  String             @id @default(cuid())
  type                ExtraRequestType   @default(OBRA)
  projectId           String?
  costCenterId        String?
  generalCostCenterId String?
  costCategoryId      Int?
  costDetailDescription String?
  description    String
  /// Quantidade pedida (obrigatória para ferramentas/material).
  quantity       Decimal?           @db.Decimal(16, 4)
  /// Valor pedido tal como foi escrito (em modo "gross" é o bruto, com IVA).
  amount         Decimal            @db.Decimal(16, 2)
  /// "base" = valor sem impostos | "gross" = valor já inclui IVA/outros
  fiscalInputMode        String?  @default("base")
  fiscalApplyVat         Boolean  @default(false)
  fiscalApplyWithholding Boolean  @default(false)
  fiscalApplyDiscount    Boolean  @default(false)
  fiscalVatPercent         Decimal? @db.Decimal(5, 2)
  fiscalWithholdingPercent Decimal? @db.Decimal(5, 2)
  fiscalDiscountPercent    Decimal? @db.Decimal(5, 2)
  /// Decomposição fiscal gravada (mesma convenção do CostPayment).
  /// O `netAmount` é o que o beneficiário recebe — a retenção fica retida —
  /// e é ele que manda em "Por pagar" e no valor por omissão do pagamento.
  baseAmount        Decimal? @db.Decimal(16, 2)
  grossAmount       Decimal? @db.Decimal(16, 2)
  vatAmount         Decimal? @db.Decimal(16, 2)
  withholdingAmount Decimal? @db.Decimal(16, 2)
  discountAmount    Decimal? @db.Decimal(16, 2)
  netAmount         Decimal? @db.Decimal(16, 2)
  currency       String             @default("AOA")
  paymentSource  ExtraPaymentSource @default(CAIXA)
  fundId         String?
  cardId         String?
  status         ExtraRequestStatus @default(PENDENTE)
  requestedBy    String?
  requestedAt    DateTime           @default(now())
  paymentDueDate DateTime?
  /// Prioridade do pedido (unificação com Pedido de Compra)
  priority       PurchasePriority   @default(NORMAL)
  /// Data desejada para entrega/realização (unificação com Pedido de Compra)
  desiredDate    DateTime?
  /// Se requer cotação / requisição formal com proforma
  requiresQuote  Boolean            @default(true)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  paidBy         String?
  paidAt         DateTime?
  notes          String?
  proformaUrl    String?
  comprovativoUrl String?
  // Beneficiário da transferência: fornecedor registado e/ou dados manuais
  supplierId     String?
  supplierName   String?
  supplierNif    String?
  supplierIban   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  costCenter        CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  generalCostCenter GeneralCostCenter? @relation(fields: [generalCostCenterId], references: [id], onDelete: SetNull)
  costCategory      CostCategory?      @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)
  fund              PettyCashFund?     @relation(fields: [fundId], references: [id], onDelete: SetNull)
  card              PettyCashCard?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  supplierRef       Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movement          PettyCashMovement?
  /// Itens do pedido (unificação com Pedido de Compra, múltiplas linhas)
  items             ExtraRequestItem[]
  workNeeds         WorkNeed[]

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([fundId])
  @@index([generalCostCenterId])
  @@index([costCategoryId])
  @@index([supplierId])
  @@index([priority])
}

/// Itens de um Pedido Extra (múltiplas linhas, como no Pedido de Compra).
model ExtraRequestItem {
  id              String        @id @default(cuid())
  extraRequestId  String
  description     String
  quantity        Decimal       @db.Decimal(16, 4)
  unit            String?
  unitPrice       Decimal?      @db.Decimal(16, 4)
  totalPrice      Decimal?      @db.Decimal(16, 4)
  notes           String?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())

  extraRequest ExtraRequest @relation(fields: [extraRequestId], references: [id], onDelete: Cascade)

  @@index([extraRequestId])
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  userEmail String?
  action    String
  module    String
  status    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
}

model Supplier {
  id                 String       @id @default(cuid())
  name               String
  type               SupplierType @default(MATERIAL)
  nif                String?
  contact            String?
  phone              String?
  email              String?
  address            String?
  category           String?
  iban               String?
  paymentTerm        String?
  vatPercent         Decimal? @db.Decimal(5, 2) // % IVA — informativo, não altera orçamento base
  withholdingPercent Decimal? @db.Decimal(5, 2) // % Retenção na fonte
  discountPercent    Decimal? @db.Decimal(5, 2) // % Desconto
  vatRegime          String?  // Regime de IVA (AGT)
  agtStatus          String?  // Estado no portal do contribuinte (AGT)
  agtType            String?  // Tipo de contribuinte (AGT)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products      SupplierProduct[]
  quotes        NeedQuote[]
  bankAccounts  SupplierBankAccount[]
  payments      CostPayment[]
  freightOrders FreightOrder[]
  extraRequests ExtraRequest[]
  purchaseOrders      PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  quoteSupplierOrders QuoteSupplierOrder[]
  bankMovements       BankMovement[]
}

enum SupplierType {
  MATERIAL
  SERVICO
  TRANSPORTADOR
}

enum FreightStatus {
  PENDENTE
  EM_ANALISE
  APPROVED
  PAGO
  CANCELADO
}

model FreightOrder {
  id            String         @id @default(cuid())
  supplierId    String
  totalAmount   Decimal        @db.Decimal(16, 2)
  currency      String         @default("AOA")
  status        FreightStatus  @default(PENDENTE)
  notes         String?
  costPaymentId String?        @unique
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  costPayment  CostPayment?        @relation(fields: [costPaymentId], references: [id], onDelete: SetNull)
  allocations  FreightAllocation[]

  @@index([supplierId])
  @@index([status])
}

model FreightAllocation {
  id             String   @id @default(cuid())
  freightOrderId String
  needQuoteId    String?
  projectId      String
  costCenterId   String?
  description    String
  amount         Decimal  @db.Decimal(16, 2)
  createdAt      DateTime @default(now())

  freightOrder FreightOrder @relation(fields: [freightOrderId], references: [id], onDelete: Cascade)
  needQuote    NeedQuote?   @relation(fields: [needQuoteId], references: [id], onDelete: SetNull)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([freightOrderId])
  @@index([projectId])
  @@index([needQuoteId])
}

model SupplierBankAccount {
  id         String   @id @default(cuid())
  supplierId String
  bankName   String
  iban       String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierProduct {
  id          String    @id @default(cuid())
  supplierId  String
  productId   String?
  name        String
  description String?
  unit        String?
  price       Decimal   @db.Decimal(16, 4)
  currency    String    @default("AOA")
  vatPercent         Decimal? @db.Decimal(5, 2)
  withholdingPercent Decimal? @db.Decimal(5, 2)
  discountPercent    Decimal? @db.Decimal(5, 2)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  quotes   NeedQuote[]

  @@unique([supplierId, productId])
  @@index([productId])
}

model NeedQuote {
  id                String    @id @default(cuid())
  needId            String
  supplierId        String
  supplierProductId String?
  quotedPrice       Decimal   @db.Decimal(16, 4)
  quantity          Decimal?  @db.Decimal(16, 4)
  totalValue        Decimal?  @db.Decimal(16, 4)
  netTotal          Decimal?  @db.Decimal(16, 2)
  vatAmount         Decimal?  @db.Decimal(16, 2)
  withholdingAmount Decimal?  @db.Decimal(16, 2)
  discountAmount    Decimal?  @db.Decimal(16, 2)
  fiscalApplyVat         Boolean @default(false)
  fiscalApplyWithholding Boolean @default(false)
  fiscalApplyDiscount    Boolean @default(false)
  vatPercent         Decimal? @db.Decimal(5, 2)
  withholdingPercent Decimal? @db.Decimal(5, 2)
  discountPercent    Decimal? @db.Decimal(5, 2)
  currency          String    @default("AOA")
  selected          Boolean   @default(false)
  notes             String?
  proformaUrl       String?
  purchaseOrderUrl  String?
  orderNumber       Int?
  supplierOrderId   String?
  poDocumentId      String?
  poIssuedBy        String?
  poIssuedAt        DateTime?

  // Crédito — preenchido apenas quando a condição de pagamento do fornecedor é "Crédito"
  creditTermDays      Int?
  expectedReceiptDate DateTime?
  installmentsPlanned Int?
  invoiceConfirmedAt  DateTime?
  invoiceConfirmedBy  String?
  receivedAt          DateTime?
  deliveryStatus      DeliveryStatus @default(PENDENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  need            WorkNeed             @relation(fields: [needId], references: [id], onDelete: Cascade)
  supplier        Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct?     @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  supplierOrder   QuoteSupplierOrder?  @relation(fields: [supplierOrderId], references: [id], onDelete: SetNull)
  installments    PaymentInstallment[]
  stockMovements  StockMovement[]
  freightAllocations FreightAllocation[]

  @@index([orderNumber])
  @@index([supplierOrderId])
}

/// Encomenda/requisição a um fornecedor com um ou vários itens cotados (mesmo EF).
model QuoteSupplierOrder {
  id                  String    @id @default(cuid())
  supplierId          String
  projectId           String?
  orderNumber         Int?      @unique
  status              String    @default("DRAFT")
  notes               String?
  proformaUrl         String?
  purchaseOrderUrl    String?
  poDocumentId        String?
  poIssuedBy          String?
  poIssuedAt          DateTime?
  expectedReceiptDate DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  supplier Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotes   NeedQuote[]

  @@index([supplierId])
  @@index([projectId])
  @@index([status])
}

enum InstallmentStatus {
  PENDENTE
  VENCIDO
  PAGO
  CANCELADO
}

// Plano de parcelas gerado automaticamente após a confirmação da fatura de uma
// encomenda a crédito. Cada parcela também é espelhada num CostPayment (via
// costPaymentId) para continuar a aparecer nos ecrãs de Cronograma/Pagamentos
// já existentes, sem duplicar lógica de apresentação.
model PaymentInstallment {
  id            String            @id @default(cuid())
  quoteId       String
  needId        String
  costPaymentId String?           @unique
  number        Int
  amount        Decimal           @db.Decimal(16, 2)
  currency      String            @default("AOA")
  dueDate       DateTime
  paidDate      DateTime?
  status        InstallmentStatus @default(PENDENTE)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  quote       NeedQuote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  need        WorkNeed                    @relation(fields: [needId], references: [id], onDelete: Cascade)
  costPayment CostPayment?                @relation(fields: [costPaymentId], references: [id], onDelete: SetNull)
  history     PaymentInstallmentHistory[]

  @@index([needId])
  @@index([quoteId])
  @@index([dueDate])
  @@index([status])
}

model PaymentInstallmentHistory {
  id            String   @id @default(cuid())
  installmentId String
  action        String
  fromValue     String?
  toValue       String?
  userId        String?
  userName      String?
  createdAt     DateTime @default(now())

  installment PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
}

// =============================================
// MÓDULO: CENTRO DE COMPRAS
// =============================================

enum PurchaseOrderStatus {
  RASCUNHO
  PENDENTE_REQUISICAO
  PENDENTE_APROVACAO
  APROVADO
  NAO_APROVADO
  EM_PAGAMENTO
  CONCLUIDO
  CANCELADO
}

enum PurchasePriority {
  NORMAL
  ALTA
  URGENTE
}

enum PurchaseType {
  PEDIDO
  ORCAMENTO
}

/// Tipo de pedido de pagamento, como no protótipo (RP_TIPOS).
enum PaymentRequestType {
  /// Pedido geral da sede
  SEDE
  /// Pedido para uma obra
  OBRA
  /// Frota e equipamentos
  FROTA
  /// Impostos (AGT): RUPE, mês de referência, data-limite
  IMPOSTOS
  /// Pessoal: linhas por colaborador
  PESSOAL
  /// Empréstimo a devolver
  EMPRESTIMO
}

/// Quem paga: o fornecedor por transferência, ou o fundo de maneio.
enum PaymentMode {
  FORN
  FM
}

/// Excepção documental de uma linha.
enum PurchaseDocException {
  /// Despesa sem comprovativo: não há documento fiscal
  DSC
  /// Autofaturação: a empresa emite o documento depois
  AF
}

enum PurchasePaymentStatus {
  PENDENTE
  PARCIAL
  PAGO
  CANCELADO
}

enum PurchaseInstallmentStatus {
  PENDENTE
  PAGO
  CANCELADO
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  number          String              @unique
  type            PurchaseType        @default(PEDIDO)
  status          PurchaseOrderStatus @default(RASCUNHO)
  priority        PurchasePriority    @default(NORMAL)
  department      String?
  requestedById   String?
  requestedByName String
  description     String
  justification   String?
  needDate        DateTime?
  requiresQuote   Boolean             @default(true)
  totalValue      Decimal?            @db.Decimal(16, 2)
  currency        String              @default("AOA")
  supplierId      String?
  supplierName    String?
  notes           String?
  projectId       String?
  costCenterId    String?

  // ─── Pedido de pagamento (Fase 5) ───
  /// Tipo do pedido. Os tipos sem itens (impostos, pessoal, empréstimo) guardam
  /// os seus dados próprios em `typeData`.
  requestType     PaymentRequestType  @default(SEDE)
  paymentMode     PaymentMode         @default(FORN)
  /// Dados próprios de cada tipo: impostos {tipo, mes, rupe, limite, valor},
  /// pessoal {sub, mes, linhas:[{nome, iban, valor}]}, empréstimo {por, modo, valor, iban, fim, prest}
  typeData        Json                @default("{}")
  /// Fundo de maneio usado quando `paymentMode` = FM
  pettyCashFundId String?
  /// Condição acordada: PRONTO | CREDITO | PARCIAL
  paymentTerm     String?             @default("PRONTO")
  /// Dias de crédito, quando a condição é CREDITO
  creditDays      Int?
  /// Data pretendida de pagamento (pronto) ou vencimento (crédito)
  dueDate         DateTime?
  /// Marcado em pausa pela Direção, sem rejeitar
  onHold          Boolean             @default(false)
  holdReason      String?
  /// Motivo da eliminação, quando o administrador apaga
  deletedReason   String?
  deletedAt       DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  pettyCashFund PettyCashFund?            @relation(fields: [pettyCashFundId], references: [id], onDelete: SetNull)
  supplier     Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  project      Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  costCenter   CostCenter?               @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]
  requisition  PurchaseRequisition?
  materialRequisitions MaterialRequisition[]
  approvals    PurchaseApproval[]
  paymentPlan  PurchasePaymentPlan?
  history      PurchaseHistoryLog[]
  workNeeds    WorkNeed[]

  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@index([projectId])
  @@index([costCenterId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  name            String
  quantity        Decimal       @db.Decimal(16, 4)
  unit            String?
  unitPrice       Decimal?      @db.Decimal(16, 4)
  totalPrice      Decimal?      @db.Decimal(16, 4)
  notes           String?
  order           Int           @default(0)

  // ─── Fiscalidade da linha (Fase 5) ───
  // Antes vinham escritas em texto nas `notes` ("IVA 14% · Ret. 6,5%") e eram lidas
  // por expressão regular; a retenção era extraída e descartada, o que fazia o
  // sistema mandar pagar mais do que o devido. Agora são colunas.
  vatPercent         Decimal? @db.Decimal(5, 2)
  withholdingPercent Decimal? @db.Decimal(5, 2)
  discountPercent    Decimal? @db.Decimal(5, 2)
  /// Excepção documental: sem comprovativo (DSC) ou autofaturação (AF)
  docException       PurchaseDocException?

  createdAt       DateTime      @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model PurchaseRequisition {
  id              String        @id @default(cuid())
  purchaseOrderId String        @unique
  quotedValue     Decimal?      @db.Decimal(16, 2)
  currency        String        @default("AOA")
  supplierId      String?
  supplierName    String?
  notes           String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplier      Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  attachments   PurchaseAttachment[]

  @@index([purchaseOrderId])
}

model PurchaseAttachment {
  id                    String              @id @default(cuid())
  purchaseRequisitionId String
  fileName              String
  mimeType              String
  size                  Int
  url                   String
  uploadedById          String?
  uploadedByName        String?
  createdAt             DateTime            @default(now())

  requisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)

  @@index([purchaseRequisitionId])
}

model PurchaseApproval {
  id              String        @id @default(cuid())
  purchaseOrderId String
  approverId      String
  approverName    String
  decision        String        // "APROVADO" | "NAO_APROVADO"
  observations    String?
  decidedAt       DateTime      @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model PurchasePaymentPlan {
  id              String                     @id @default(cuid())
  purchaseOrderId String                     @unique
  totalValue      Decimal                    @db.Decimal(16, 2)
  currency        String                     @default("AOA")
  status          PurchasePaymentStatus      @default(PENDENTE)
  notes           String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  purchaseOrder PurchaseOrder                @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  installments  PurchasePaymentInstallment[]

  @@index([purchaseOrderId])
}

model PurchasePaymentInstallment {
  id            String                    @id @default(cuid())
  paymentPlanId String
  number        Int
  amount        Decimal                   @db.Decimal(16, 2)
  currency      String                    @default("AOA")
  dueDate       DateTime
  paidAt        DateTime?
  status        PurchaseInstallmentStatus @default(PENDENTE)
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  paymentPlan PurchasePaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId])
  @@index([dueDate])
  @@index([status])
}

model PurchaseHistoryLog {
  id              String        @id @default(cuid())
  purchaseOrderId String
  action          String
  fromStatus      String?
  toStatus        String?
  userId          String?
  userName        String?
  notes           String?
  createdAt       DateTime      @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([createdAt])
}

enum HelpTicketType {
  MELHORIA
  DUVIDA
}

enum HelpTicketStatus {
  ABERTO
  EM_ANALISE
  RESOLVIDO
}

model HelpTicket {
  id            String           @id @default(cuid())
  type          HelpTicketType
  status        HelpTicketStatus @default(ABERTO)
  message       String
  pageUrl       String
  pageTitle     String?
  screenshotUrl String?
  adminReply    String?
  createdById   String
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  createdBy  User  @relation("HelpTicketAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("HelpTicketResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdById])
  @@index([type, status])
}

// ─── Cadastros persistentes (Fase 1 — D-002/D-012) ───────────────────────────
// Substituem os registos de contactos, setores e pessoal que viviam em
// localStorage. `legacyId` guarda o id gerado no browser para importação
// idempotente; `importBatchId` liga ao lote para rollback.

enum PersonnelType {
  INTERNO
  SUBCONTRATADO
}

model Contact {
  id            String   @id @default(cuid())
  name          String
  role          String
  phone         String?
  email         String?
  photoUrl      String?
  active        Boolean  @default(true)
  legacyId      String?  @unique
  importBatchId String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   User?                @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  importBatch RegistryImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  projects    ProjectContact[]

  @@index([name])
  @@index([active])
  @@index([importBatchId])
}

model Sector {
  id            String   @id @default(cuid())
  name          String
  nameKey       String   @unique
  active        Boolean  @default(true)
  legacyId      String?  @unique
  importBatchId String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy   User?                @relation("SectorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  importBatch RegistryImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([importBatchId])
}

model Personnel {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String?
  email         String?
  phone         String?
  type          PersonnelType?
  role          String
  /// Obra principal (primeira da lista). Compatibilidade com código legado que lê um só id.
  /// Fonte da verdade para internos: PersonnelProject.
  projectId     String?
  employeeCode  String?
  category      String?
  photoUrl      String?
  active        Boolean        @default(true)

  // ─── Ficha de funcionário (módulo Comercial › Base › Funcionários) ───
  /// Departamento: ver a lista `departamentos` em CompanySetting("budget.lists")
  department       String?
  /// Vínculo: ver a lista `vinculos` em CompanySetting("budget.lists")
  contractType     String?
  admissionDate    DateTime?
  idNumber         String?
  taxNumber        String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?

  legacyId      String?        @unique
  importBatchId String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectAssignments  PersonnelProject[]
  createdBy           User?                @relation("PersonnelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  importBatch         RegistryImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([firstName, lastName])
  @@index([projectId])
  @@index([type])
  @@index([active])
  @@index([importBatchId])
  @@index([department])
}

/// N:N funcionário ↔ obra. Fonte da verdade das alocações (internos: 0..N obras).
model PersonnelProject {
  id          String   @id @default(cuid())
  personnelId String
  projectId   String
  createdAt   DateTime @default(now())

  personnel Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([personnelId, projectId])
  @@index([projectId])
  @@index([personnelId])
}

enum RegistryResource {
  CONTACTS
  SECTORS
  PERSONNEL
}

model RegistryImportBatch {
  id           String           @id @default(cuid())
  resource     RegistryResource
  source       String           @default("localStorage")
  sourceKey    String
  deviceLabel  String?
  requested    Int
  created      Int
  skipped      Int
  failed       Int
  details      Json?
  rolledBackAt DateTime?
  createdById  String
  createdAt    DateTime         @default(now())

  createdBy User        @relation("RegistryImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  contacts  Contact[]
  sectors   Sector[]
  personnel Personnel[]

  @@index([resource, createdAt])
  @@index([createdById])
}

// =============================================
// MÓDULO: ÁREA FINANCEIRA
// Faturação (faturas de cliente), Tesouraria (extratos/movimentos bancários)
// e regras de confirmação de custos.
// =============================================

enum InvoiceStatus {
  EM_ABERTO
  PAGO_PARCIAL
  PAGO_TOTAL
  ATRASADO
}

enum BankDocType {
  FATURA
  AF
}

enum BankMovementType {
  TRANSFERENCIA_INTERNA
  PF
  REEMBOLSO
  OPERACAO_ANULADA
  RECEBIMENTO_CLIENTE
  LEVANTAMENTO_ATM
  OUTRO
}

enum BankMovementDirection {
  ENTRADA
  SAIDA
}

enum CostConfirmationStatus {
  POR_CONFIRMAR
  CONFIRMADO
}

// Fatura emitida ao cliente (receita) — folha "RECEBIMENTOS – REGISTO".
model Invoice {
  id                 String        @id @default(cuid())
  projectId          String
  clientId           String?
  measurementId      String? // Auto de Medição (AM) associado
  docNumber          String?
  docDate            DateTime
  dueDate            DateTime?
  grossAmount        Decimal       @db.Decimal(16, 2) // V. Ilíquido Doc
  withholdingAmount  Decimal?      @db.Decimal(16, 2) // V. Retenção na Fonte
  vatAmount          Decimal?      @db.Decimal(16, 2) // V. IVA
  carInsuranceAmount Decimal?      @db.Decimal(16, 2) // Seguro CAR
  guaranteeAmount    Decimal?      @db.Decimal(16, 2) // Garantia
  netAmount          Decimal?      @db.Decimal(16, 2) // V. Líq. Doc
  workPercent        Decimal?      @db.Decimal(5, 2) // % Obra
  flagRetention      Boolean       @default(false)
  flagVatCativo      Boolean       @default(false)
  flagCar            Boolean       @default(false)
  flagGuarantee      Boolean       @default(false)
  status             InvoiceStatus @default(EM_ABERTO)
  receivedAmount     Decimal       @default(0) @db.Decimal(16, 2)
  receivedDate       DateTime?
  notes              String?
  createdBy          String?

  // Documento físico da fatura (PDF ou imagem) — carregado pelo financeiro
  // ou anexado automaticamente após a leitura com IA.
  documentPath       String? // caminho guardado (uploads/...)
  documentName       String? // nome original do ficheiro
  documentMimeType   String?
  documentSize       Int?
  documentUploadedAt DateTime?
  documentUploadedBy String?

  // Origem do preenchimento: IA (Gemini) ou MANUAL.
  scanSource         String?
  scanModel          String?
  scanRaw            Json?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client      Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  measurement MeasurementReport? @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  receipts    InvoiceReceipt[]

  @@index([projectId, docDate])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([documentPath])
}

// Recebimento (parcial ou total) de uma fatura.
model InvoiceReceipt {
  id           String   @id @default(cuid())
  invoiceId    String
  amount       Decimal  @db.Decimal(16, 2)
  receivedDate DateTime
  method       String?
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  // Movimento do extrato (entrada) que trouxe este dinheiro. Um movimento pode
  // pagar várias faturas; a soma dos recebimentos não pode passar o valor dele.
  bankMovementId String?

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bankMovement BankMovement? @relation(fields: [bankMovementId], references: [id], onDelete: SetNull)

  @@index([invoiceId, receivedDate])
  @@index([bankMovementId])
}

// Extrato bancário importado para a área financeira.
model BankStatement {
  id          String    @id @default(cuid())
  cardId      String?
  name        String
  periodStart DateTime?
  periodEnd   DateTime?
  // Saldos impressos no extrato: servem para conferir os movimentos e fixam o
  // saldo da conta na data de fim do período.
  openingBalance Decimal?  @db.Decimal(16, 2)
  closingBalance Decimal?  @db.Decimal(16, 2)
  fileName    String?
  notes       String?
  createdBy   String?
  createdAt   DateTime  @default(now())

  card      PettyCashCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  movements BankMovement[]
  balances  BankBalance[]

  @@index([cardId])
}

// Movimento de um extrato bancário, classificado pela área financeira.
model BankMovement {
  id             String                @id @default(cuid())
  statementId    String
  cardId         String?
  projectId      String?
  docNumber      String?
  docType        BankDocType?
  supplierId     String?
  movementType   BankMovementType      @default(OUTRO)
  costCategoryId String? // Tipo/Categoria de custo
  subcategoryId  String? // Subcategoria de custo
  direction      BankMovementDirection
  amount         Decimal               @db.Decimal(16, 2)
  movementDate   DateTime
  description    String?
  isMerchandise  Boolean               @default(false) // compra de mercadorias (custo via stock)
  costAssigned   Boolean               @default(false) // já tem custo associado
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  card      PettyCashCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supplier  Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receipts  InvoiceReceipt[]

  @@index([statementId])
  @@index([projectId, movementDate])
  @@index([movementType])
  @@index([costAssigned])
}

// Saldo de um cartão / conta bancária numa data — vem do saldo final de um
// extrato ou de um acerto manual da tesouraria. O saldo atual da conta é o
// último registo mais os movimentos do extrato posteriores a essa data.
model BankBalance {
  id          String   @id @default(cuid())
  cardId      String
  balance     Decimal  @db.Decimal(16, 2)
  balanceDate DateTime
  source      String   @default("MANUAL") // EXTRATO | MANUAL
  statementId String?
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  card      PettyCashCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  statement BankStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([cardId, balanceDate])
}

// ─── Inteligência Artificial (Fase 2.0) ─────────────────────────────────────

/// Configuração global da IA (linha única, id = "default"), gerida no
/// separador "Inteligência Artificial" da Gestão do Sistema (só admin).
model AiSettings {
  id                   String    @id @default("default")
  enabled              Boolean   @default(true)
  /// Adaptador em src/services/ai/providers ("gemini", "openai_compatible").
  provider             String    @default("gemini")
  model                String    @default("gemini-3.8-flash")
  fallbackModels       Json      @default("[]")
  baseUrl              String?
  /// Chave cifrada (AES-256-GCM com o JWT_SECRET). Nunca sai do servidor.
  apiKeyWrapped        String?
  /// { assistant, chat_mention, digests, alerts, voice, photos, invoice_scan }
  features             Json      @default("{}")
  /// Categoria de dados → "off" | "on" | "anonymize"
  dataCategories       Json      @default("{}")
  monthlyBudget        Decimal?  @db.Decimal(12, 2)
  budgetCurrency       String    @default("USD")
  /// Preço por 1 milhão de tokens (para estimar o custo de cada pedido).
  inputPricePerMTok    Decimal?  @db.Decimal(12, 4)
  outputPricePerMTok   Decimal?  @db.Decimal(12, 4)
  dailyRequestsPerUser Int       @default(50)
  /// "AAAA-MM" do último aviso de 80 % do orçamento (para avisar 1x por mês).
  budgetAlertMonth     String?
  updatedAt            DateTime  @updatedAt
  updatedById          String?
}

/// Obras que nunca são enviadas à IA.
model AiDataExclusion {
  projectId   String   @id
  createdAt   DateTime @default(now())
  createdById String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Quem recebe cada resumo/alerta da IA (configurado na Gestão).
model DigestRecipientRule {
  id         String   @id @default(cuid())
  /// DAILY_SUMMARY | WEEKLY_SUMMARY | PREDICTIVE_ALERTS | URGENT_ALERTS
  digestType String
  /// PROJECT_DIRECTOR | DIRECTION | FINANCE | OPERATORS
  group      String
  enabled    Boolean  @default(true)
  /// ["in_app", "email"]
  channels   Json     @default("[\"in_app\"]")
  /// FULL | OPERATIONAL | FINANCIAL
  content    String   @default("FULL")
  sendTime   String   @default("07:30")
  /// Utilizadores escolhidos (DIRECTION / OPERATORS).
  userIds    Json     @default("[]")
  /// Obras incluídas; vazio = todas as obras a que o utilizador tem acesso.
  projectIds Json     @default("[]")
  /// Último período enviado pelo agendador (ex.: "2026-11-16" ou "2026-W47").
  lastRunKey String?
  updatedAt  DateTime @updatedAt

  @@unique([digestType, group])
}

/// Resumo (diário/semanal) entregue a um utilizador. Os números vêm do sistema;
/// a IA só escreve os pontos de atenção (aiUsed).
model AiDigest {
  id         String   @id @default(cuid())
  userId     String
  digestType String
  /// Período: "2026-11-16" (diário) ou "2026-W47" (semanal).
  periodKey  String
  title      String
  summary    String
  /// { projects: [...secções por obra], highlights: [...] }
  content    Json
  projectIds Json     @default("[]")
  aiUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digestType, periodKey])
  @@index([userId, createdAt])
}

/// Registo de cada pedido à IA: o que foi enviado, quem pediu, consumo e custo.
model AiRequestLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  userId        String?
  feature       String
  provider      String
  model         String?
  categories    Json     @default("[]")
  projectIds    Json     @default("[]")
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Decimal? @db.Decimal(12, 6)
  /// OK | ERROR | BLOCKED
  status        String
  errorMessage  String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

/// Conversa com o assistente da obra (privada de cada utilizador).
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  projectId String?
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  /// "user" | "assistant"
  role           String
  content        String
  /// Ferramentas usadas na resposta: [{ name, label, projectId }] (fontes mostradas ao utilizador).
  sources        Json           @default("[]")
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ════════════════════════════════════════════════════════════════════════════
// MÓDULO COMERCIAL / ORÇAMENTAÇÃO (Fase 0 — fundação)
// Ver .plans/"Plano Faseado — Módulo Comercial (Orçamentação) espelhado no protótipo MBT.md"
// ════════════════════════════════════════════════════════════════════════════

enum BudgetStatus {
  EM_ELABORACAO
  EM_ANALISE
  APROVADO
  PROPOSTA_ENVIADA
  ADJUDICADO
  PERDIDO
  CANCELADO
}

enum PriceMethod {
  MARGEM_SOBRE_VENDA
  MARKUP_SOBRE_CUSTO
  /// Preço dado pelo cliente: o PV é o total do mapa de quantidades e a
  /// margem é o que sobra depois do custo.
  PRECO_DADO
}

enum BaremKind {
  COMBUSTIVEL
  RH
  EQUIPAMENTO
  VIATURA
  FERRAMENTA
  LOGISTICA
}

enum ProposalStatus {
  RASCUNHO
  ENVIADA
  ACEITE
  RECUSADA
}

/// Orçamento (pré-adjudicação). O documento vive em `params`/`sheets`/`baremSnapshot`
/// (JSONB, como o estado `S` do protótipo); as colunas servem listas, filtros e relatórios.
model Budget {
  id       String       @id @default(cuid())
  /// ORC-2026-0001 (sequencial por ano). As revisoes mantem o numero: a chave e (number, revision).
  number   String
  revision String       @default("R0")
  status   BudgetStatus @default(EM_ELABORACAO)
  /// Adjudicado → só consulta (equivale a S.meta.locked)
  locked   Boolean      @default(false)

  clientId        String?
  projectName     String
  location        String?
  /// Código do centro de custo reservado (CC-2026-0001). O CostCenter real nasce na adjudicação.
  costCenterCode  String?
  responsibleName String?
  projectDirName  String?

  date          DateTime  @default(now())
  startDate     DateTime?
  endDate       DateTime?
  priceBaseDate DateTime?
  validityDays  Int       @default(30)

  currencyBase     String      @default("AOA")
  currencyRef      String?
  method           PriceMethod @default(MARGEM_SOBRE_VENDA)
  marginMin        Decimal?    @db.Decimal(7, 4)
  marginTarget     Decimal?    @db.Decimal(7, 4)
  vatRate          Decimal?    @db.Decimal(7, 4)
  commercialAdjust Decimal?    @db.Decimal(16, 2)

  /// Parâmetros do orçamento (bloco A–E dos Parâmetros)
  params        Json @default("{}")
  /// Folhas de custo: mat, rh, eq, vi, fe, sub, log, eng, ind, fin, ris, prod
  sheets        Json @default("{}")
  /// Fotografia dos baremes no momento da criação / última aplicação
  baremSnapshot Json @default("{}")
  /// Listas de validação (funções, unidades, famílias, tipo de ferramenta, categoria de risco)
  lists         Json @default("{}")
  /// Condições de pagamento do cliente (modo, marcos, prazos, retenção)
  paymentTerms  Json @default("{}")
  /// Folha de despacho (decisão, preparado por, aprovado por, data, observações)
  dispatch      Json @default("{}")

  // Resultados materializados pelo motor de cálculo
  directCost     Decimal? @db.Decimal(16, 2)
  totalCost      Decimal? @db.Decimal(16, 2)
  salePriceExVat Decimal? @db.Decimal(16, 2)
  salePriceInVat Decimal? @db.Decimal(16, 2)
  grossMargin    Decimal? @db.Decimal(16, 2)
  grossMarginPct Decimal? @db.Decimal(7, 4)
  /// good | warn | bad
  marginState    String?

  awardedProjectId String? @unique
  /// Concorrência otimista: PATCH só avança se a versão coincidir
  version          Int     @default(1)
  createdById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client         Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  awardedProject Project?   @relation(fields: [awardedProjectId], references: [id], onDelete: SetNull)
  createdBy      User?      @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  proposals      Proposal[]

  @@unique([number, revision])
  @@index([status, date])
  @@index([clientId])
  @@index([number])
}

/// Biblioteca de baremes da empresa (custos internos padrão). A ligação às folhas
/// de custo é pelo NOME do recurso, como no protótipo.
model BaremItem {
  id   String    @id @default(cuid())
  kind BaremKind
  code String?
  name String
  unit String?
  /// Campos próprios de cada tipo (mensal, encargos, consumo, depreciação…)
  fields Json   @default("{}")
  /// Custo calculado pelas fórmulas, materializado para listas e para as folhas
  computedCost Decimal? @db.Decimal(16, 4)
  /// Data do preço — base do estado Atualizado / Desatualizado
  priceDate    DateTime?
  /// Equipamentos: Próprio | Alugado
  ownership    String?
  active       Boolean   @default(true)
  notes        String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?               @relation("BaremCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  history   BaremPriceHistory[]

  @@unique([kind, name])
  @@index([kind, active])
}

/// Histórico de preços de cada barém — responde a «porque é que este custo subiu».
model BaremPriceHistory {
  id           String    @id @default(cuid())
  baremId      String
  fields       Json      @default("{}")
  computedCost Decimal?  @db.Decimal(16, 4)
  priceDate    DateTime?
  changedById  String?
  changedAt    DateTime  @default(now())

  barem     BaremItem @relation(fields: [baremId], references: [id], onDelete: Cascade)
  changedBy User?     @relation("BaremPriceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([baremId, changedAt])
}

/// Parâmetros padrão da empresa e listas de validação (chave → valor JSON).
/// Cada orçamento recebe uma cópia destes valores em `Budget.params` ao ser criado.
model CompanySetting {
  key         String   @id
  value       Json
  label       String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("CompanySettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Proposta ao cliente, gerada a partir do orçamento aprovado em despacho.
model Proposal {
  id         String         @id @default(cuid())
  /// PROP-2026-0001 (sequencial por ano)
  number     String         @unique
  budgetId   String
  status     ProposalStatus @default(RASCUNHO)
  body       Json           @default("{}")
  /// O documento completo da Proposta Tecnica e Comercial (o que o modelo desenha)
  document   Json           @default("{}")
  /// Como a lista de precos se apresenta: fmt, mat, serv
  docOptions Json           @default("{}")
  /// Outros orcamentos, quando a proposta junta varios lotes
  extraBudgetIds Json       @default("[]")
  validUntil DateTime?
  sentAt     DateTime?
  pdfUrl     String?

  /// Fotografia do orcamento no momento em que a proposta foi criada
  currency   String    @default("AOA")
  totalExVat Decimal?  @db.Decimal(16, 2)
  totalInVat Decimal?  @db.Decimal(16, 2)
  vatRate    Decimal?  @db.Decimal(7, 4)
  /// Condicoes de pagamento propostas ao cliente
  paymentTerms Json    @default("{}")
  sentById   String?
  decidedAt  DateTime?
  decisionNotes String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentBy    User?  @relation("ProposalSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([status])
}

/// Contadores sequenciais por ano (ORC, CC, PROP, OB). Incremento transacional.
model DocumentCounter {
  /// ex.: "ORC", "PROP", "CC"
  kind      String
  year      Int
  last      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([kind, year])
}

// ════════════════════════════════════════════════════════════════════════════
// REQUISIÇÃO DE MATERIAL (Fase 4 do módulo Comercial / Logística)
//
// UM documento para os dois pedidos que o protótipo separava:
//   destino ARMAZEM → o armazém atende do stock (era o `sreq`/`finReqInt`)
//   destino COMPRA  → segue para compra (era o `oreq`)
// O armazém pode mudar de ARMAZEM para COMPRA quando não há stock: é uma
// transição, não um documento novo. Ver o plano, §S1.
// ════════════════════════════════════════════════════════════════════════════

enum RequisitionDestination {
  /// O armazém atende do stock que tem
  ARMAZEM
  /// Não há stock (ou nunca houve): tem de se comprar
  COMPRA
}

enum RequisitionStatus {
  RASCUNHO
  SUBMETIDA
  APROVADA
  /// Entregue em parte: falta material
  PARCIAL
  ATENDIDA
  /// Convertida em pedido de compra
  EM_COMPRA
  RECUSADA
  CANCELADA
}

model MaterialRequisition {
  id     String                 @id @default(cuid())
  /// RM-2026-0001 (sequencial por ano)
  number String                 @unique
  destination RequisitionDestination @default(ARMAZEM)
  status RequisitionStatus      @default(RASCUNHO)

  // ─── quem pede ───
  /// Obra que pede. Vazio = um departamento da sede.
  projectId       String?
  department      String?
  costCenterId    String?
  /// Categoria de custo (MAT, FE, LOG…), para o custo cair no sítio certo
  costCategory    String?
  requestedById   String?
  requestedByName String
  neededBy        DateTime?
  justification   String?

  // ─── quem atende ───
  /// Armazém de onde sai o material
  sourceWarehouseId String?
  /// Para onde vai: o armazém da obra, ou consumo direto na sede
  targetWarehouseId String?

  // ─── decisões ───
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  refusalReason  String?
  deliveredAt    DateTime?
  /// Pedido de compra criado quando o destino passou a COMPRA
  purchaseOrderId String?

  notes   String?
  /// Histórico do documento: [{ at, by, action, detail }]
  history Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  requestedBy     User?          @relation("RequisitionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy      User?          @relation("RequisitionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  sourceWarehouse Warehouse?     @relation("RequisitionSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  targetWarehouse Warehouse?     @relation("RequisitionTargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  items           MaterialRequisitionItem[]
  movements       StockMovement[]

  @@index([status, createdAt])
  @@index([projectId])
  @@index([destination, status])
}

model MaterialRequisitionItem {
  id            String  @id @default(cuid())
  requisitionId String
  /// Produto do catálogo. Vazio = escrito à mão (o armazém identifica depois).
  productId     String?
  description   String
  unit          String?
  quantity      Decimal @db.Decimal(16, 4)
  /// Quanto já foi entregue
  fulfilledQuantity Decimal @default(0) @db.Decimal(16, 4)
  /// Preço estimado, só para dar ideia do valor do pedido
  estimatedUnitPrice Decimal? @db.Decimal(16, 4)
  notes String?
  order Int     @default(0)

  requisition MaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([requisitionId])
  @@index([productId])
}
