generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String?
  passwordHash             String
  role                     Role                      @default(leitura)
  createdAt                DateTime                  @default(now())
  clientId                 String?
  profilePic               String?
  items                    Item[]
  client                   Client?                   @relation("PrimaryClient", fields: [clientId], references: [id])
  accounts                 UserClient[]
  assignedProjects         Project[]                 @relation("AssignedUsers")
  dailyPlanTasks           DailyPlanTask[]
  permissions              UserPermission[]
  systemLogs               SystemLog[]
  profile                  UserProfile?
  presence                 UserPresence?
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  messageReads             MessageRead[]
  mentionsReceived         Mention[]                 @relation("MentionsReceived")
  notifications            Notification[]
  permissionAuditLogs      PermissionAuditLog[]

  @@index([clientId])
}

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  phone                String?
  whatsapp             String?
  jobTitle             String?
  bio                  String?
  isFinancialReceiver  Boolean  @default(false)
  isApprover           Boolean  @default(false)
  isProjectResponsible Boolean  @default(false)
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PresenceStatus {
  ONLINE
  AWAY
  OFFLINE
}

model UserPresence {
  userId     String         @id
  status     PresenceStatus @default(OFFLINE)
  lastSeenAt DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType          @default(DIRECT)
  title        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  status         MessageStatus       @default(SENT)
  createdAt      DateTime            @default(now())
  editedAt       DateTime?
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation("MessageSender", fields: [senderId], references: [id])
  reads          MessageRead[]
  mentions       Mention[]
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Mention {
  id              String  @id @default(cuid())
  messageId       String
  mentionedUserId String
  message         Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser   User    @relation("MentionsReceived", fields: [mentionedUserId], references: [id])

  @@index([mentionedUserId])
}

enum NotificationType {
  NEW_MESSAGE
  MENTION
  REQUEST
  APPROVAL
  SYSTEM
  PAYMENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  fileName  String
  mimeType  String
  size      Int
  path      String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model UserClient {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  role      Role     @default(leitura)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

model Client {
  id           String             @id @default(cuid())
  code         String             @unique
  name         String
  industry     String?
  region       String?
  tier         String?
  status       ClientStatus       @default(ACTIVE)
  healthScore  Int                @default(50)
  ltvTotal     Decimal            @db.Decimal(14, 2)
  churnRisk    Decimal            @db.Decimal(5, 2)
  ltvPotential Decimal            @db.Decimal(14, 2)
  profilePic   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  alerts       Alert[]
  tags         ClientTag[]
  interactions InteractionEvent[]
  projects     Project[]
  primaryUsers User[]             @relation("PrimaryClient")
  users        UserClient[]

  @@index([name])
  @@index([status])
}

model ClientTag {
  id       String @id @default(cuid())
  clientId String
  tag      String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, tag])
}

model Project {
  id                  String                   @id @default(cuid())
  code                String                   @unique
  name                String
  location            String?
  region              String?
  status              ProjectStatus            @default(ACTIVE)
  active              Boolean                  @default(true)
  startDate           DateTime?
  dueDate             DateTime?
  budgetTotal         Decimal                  @db.Decimal(16, 2)
  budgetAllocated     Decimal                  @db.Decimal(16, 2)
  budgetConsumed      Decimal                  @db.Decimal(16, 2)
  budgetCommitted     Decimal                  @db.Decimal(16, 2)
  budgetAvailable     Decimal                  @db.Decimal(16, 2)
  budgetVersion       Int                      @default(1)
  physicalProgressPct Float                    @default(0)
  currency            String?                  @default("AOA")
  phaseLabel          String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  clientId            String?
  contact             String?
  projectType         String?
  empreiteiro         String?
  subempreiteiro      String?
  directorObra        String?
  directorPhoto       String?
  directorPhone       String?
  directorEmail       String?
  technicians         Json?                    @default("[]")
  referencia          String?
  lastAccidentDate    DateTime?
  activeStaffCount    Int?                     @default(0)
  safetyHistory       Json?
  maoDeObraIndireta   Json?
  maoDeObraDireta     Json?
  equipamentos        Json?
  alerts              Alert[]
  client              Client?                  @relation(fields: [clientId], references: [id])
  budgetLines         ProjectBudgetLine[]
  files               ProjectFile[]
  folders             ProjectFolder[]
  payments            ProjectPayment[]
  photos              ProjectPhoto[]
  progressHistory     ProjectProgressHistory[]
  progressTasks       ProjectProgressTask[]
  measurementReports  MeasurementReport[]
  transactions        ProjectTransaction[]
  stockMovements      StockMovement[]
  warehouses          Warehouse[]
  assignedUsers       User[]                   @relation("AssignedUsers")
  dailyPlans          DailyPlan[]
  materialPlans       ProjectMaterialPlan[]
  costCenters         CostCenter[]
  workNeeds           WorkNeed[]
  costPayments        CostPayment[]
  pettyCashFunds      PettyCashFund[]
  extraRequests       ExtraRequest[]
  freightAllocations  FreightAllocation[]

  @@index([name])
  @@index([status])
}

model ProjectFolder {
  id        String          @id @default(cuid())
  name      String
  projectId String
  parentId  String?
  createdAt DateTime        @default(now())
  files     ProjectFile[]
  parent    ProjectFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFolder[] @relation("FolderChildren")
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, parentId, createdAt])
}

model ProjectFile {
  id           String         @id @default(cuid())
  projectId    String
  originalName String
  mimeType     String
  size         Int
  path         String
  category     String?        @default("OUTROS")
  createdAt    DateTime       @default(now())
  folderId     String?
  folder       ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectBudgetLine {
  id           String               @id @default(cuid())
  projectId    String
  version      Int                  @default(1)
  rowNumber    Int?
  sourceFile   String?
  category     String?
  description  String
  unit         String?
  quantity     Decimal?             @db.Decimal(16, 4)
  unitPrice    Decimal?             @db.Decimal(16, 4)
  total        Decimal              @db.Decimal(16, 2)
  createdAt    DateTime             @default(now())
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions ProjectTransaction[]
  workNeeds    WorkNeed[]

  @@index([projectId, createdAt])
  @@index([projectId, version])
}

model ProjectTransaction {
  id             String              @id @default(cuid())
  projectId      String
  date           DateTime
  description    String
  category       TransactionCategory @default(OTHER)
  ownerName      String?
  status         TransactionStatus   @default(PENDING)
  amount         Decimal             @db.Decimal(16, 2)
  realizedAmount Decimal?            @db.Decimal(16, 2)
  budgetLineId   String?
  currency       String?

  // Novos campos: Centro de Custo, Fornecedor, Tipo Pagamento
  costCenterId String?
  supplier     String?
  paymentType  String? @default("PRONTO_PAGAMENTO")

  budgetLine ProjectBudgetLine? @relation(fields: [budgetLineId], references: [id])
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenter CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([costCenterId])
}

model InteractionEvent {
  id          String   @id @default(cuid())
  clientId    String
  type        String
  title       String
  description String?
  occurredAt  DateTime
  leadName    String?
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt])
}

model Alert {
  id        String        @id @default(cuid())
  severity  AlertSeverity @default(MEDIUM)
  status    AlertStatus   @default(OPEN)
  title     String
  body      String?
  createdAt DateTime      @default(now())
  clientId  String?
  projectId String?
  client    Client?       @relation(fields: [clientId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id])

  @@index([status, severity, createdAt])
}

model ProjectProgressTask {
  id                String                   @id @default(cuid())
  projectId         String
  itemGroup         String?
  wbsCode           String?
  parentId          String?
  order             Int                      @default(0)
  description       String
  expectedQty       Decimal                  @db.Decimal(18, 10)
  executedQty       Decimal                  @default(0) @db.Decimal(18, 10)
  unit              String
  unitValue         Decimal?                 @db.Decimal(18, 8)
  unitValueMaterial Decimal?                 @db.Decimal(18, 8)
  unitValueService  Decimal?                 @db.Decimal(18, 8)
  totalValue        Decimal?                 @db.Decimal(18, 8)
  currency          String?                  @default("AOA")
  createdAt         DateTime                 @default(now())
  history           ProjectProgressHistory[]
  parent            ProjectProgressTask?     @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks          ProjectProgressTask[]    @relation("SubTasks")
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyPlanTasks    DailyPlanTask[]

  @@index([projectId, itemGroup, order])
}

model ProjectProgressHistory {
  id             String              @id @default(cuid())
  projectId      String
  taskId         String
  date           DateTime            @default(now())
  executedQty    Decimal             @db.Decimal(18, 10)
  accumulatedQty Decimal             @db.Decimal(18, 10)
  technicianName String?
  notes          String?
  createdAt      DateTime            @default(now())
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           ProjectProgressTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, taskId, date])
}

model MeasurementReport {
  id             String    @id @default(cuid())
  projectId      String
  reportNumber   String
  reportDate     DateTime
  prevDate       DateTime?
  status         String    @default("DRAFT")
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  snapshotData   Json?
  periodQtyTotal Decimal?  @db.Decimal(18, 2)
  periodValTotal Decimal?  @db.Decimal(18, 2)
  createdAt      DateTime  @default(now())
  createdBy      String?
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, reportNumber])
  @@index([projectId, reportDate])
}

model ProjectPayment {
  id               String        @id @default(cuid())
  projectId        String
  valor            Decimal       @db.Decimal(16, 2)
  dataPagamento    DateTime
  metodo           String?
  referencia       String?
  comprovativoPath String?
  criadoPor        String?
  status           PaymentStatus @default(PENDENTE)
  createdAt        DateTime      @default(now())
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, dataPagamento])
}

model Warehouse {
  id              String           @id @default(cuid())
  name            String
  type            WarehouseType    @default(CENTRAL)
  active          Boolean          @default(true)
  visibleToClient Boolean          @default(false)
  projectId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           Item[]
  targetItems     Item[]           @relation("ItemTargetWarehouse")
  movements       StockMovement[]
  project         Project?         @relation(fields: [projectId], references: [id])
  stock           WarehouseStock[]

  @@index([projectId])
}

model Product {
  id                 String                @id @default(cuid())
  sku                String?               @unique
  barcode            String?               @unique
  name               String
  description        String?
  image              String?
  category           ProductCategory       @default(MATERIAL)
  unit               ProductUnit           @default(UN)
  minStock           Decimal               @default(0) @db.Decimal(16, 4)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  items              Item[]
  movements          StockMovement[]
  stock              WarehouseStock[]
  dailyPlanMaterials DailyPlanMaterial[]
  projectPlans       ProjectMaterialPlan[]
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  ownerId     String?
  quantity    Decimal   @default(0) @db.Decimal(16, 4)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, ownerId])
}

model Item {
  id                String     @id @default(cuid())
  serialNumber      String?    @unique
  internalTag       String?    @unique
  productId         String
  warehouseId       String?
  targetWarehouseId String?
  projectId         String?
  responsibleId     String?
  status            ItemStatus @default(AVAILABLE)
  condition         String?    @default("GOOD")
  notes             String?
  lastStatusNote    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  assignedAt        DateTime?
  imageUrl          String?
  returnedAt        DateTime?
  product           Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  responsible       User?      @relation(fields: [responsibleId], references: [id])
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])
  targetWarehouse   Warehouse? @relation("ItemTargetWarehouse", fields: [targetWarehouseId], references: [id])

  @@index([productId])
  @@index([status])
}

model StockMovement {
  id              String         @id @default(cuid())
  projectId       String?
  type            MovementType
  quantity        Decimal        @db.Decimal(16, 4)
  notes           String?
  createdAt       DateTime       @default(now())
  evidenceUrl     String?
  vehicleImageUrl String?
  ownerId         String?
  productId       String
  reference       String?
  sourceQuoteId   String?
  userId          String
  warehouseId     String
  photos          ProjectPhoto[]
  product         Product        @relation(fields: [productId], references: [id])
  project         Project?       @relation(fields: [projectId], references: [id])
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  sourceQuote     NeedQuote?     @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)

  @@index([sourceQuoteId])
}

model ProjectPhoto {
  id          String         @id @default(cuid())
  projectId   String
  movementId  String?
  path        String
  lat         Decimal?       @db.Decimal(10, 8)
  lng         Decimal?       @db.Decimal(11, 8)
  takenAt     DateTime?
  description String?
  createdAt   DateTime       @default(now())
  itemId      String?
  movement    StockMovement? @relation(fields: [movementId], references: [id])
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RolePermission {
  id      String @id @default(cuid())
  role    String
  module  String
  action  String
  allowed String

  @@unique([role, module, action])
  @@index([role])
  @@map("role_permissions")
}

/// Overrides de permissão por utilizador (prevalece sobre o perfil/role)
model UserPermission {
  id      String @id @default(cuid())
  userId  String
  module  String
  action  String
  allowed String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, action])
  @@index([userId])
  @@map("user_permissions")
}

model PermissionAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  targetType  String? // "role" or "user"
  targetId    String? // role name or user id
  role        String?
  module      String?
  action      String?
  beforeValue String?
  afterValue  String?
  reason      String?
  context     Json?
  createdAt   DateTime @default(now())

  actorUser User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("permission_audit_logs")
}

enum WarehouseType {
  CENTRAL
  SITE
  CLIENT
}

enum ProductCategory {
  MATERIAL
  TOOL
  EQUIPMENT
  CONSUMABLE
}

enum ProductUnit {
  UN
  KG
  M
  L
  CX
  PAR
  MT2
  MT3
}

enum ItemStatus {
  AVAILABLE
  PENDING_RECEIPT
  ASSIGNED
  PENDING_RETURN
  MAINTENANCE
  BROKEN
  LOST
  RETIRED
}

enum MovementType {
  ENTRY
  EXIT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  LOSS
}

enum Role {
  admin
  operador
  financeiro
  tecnico
  supervisor
  leitura
  cliente
}

enum ClientStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TransactionCategory {
  MATERIALS
  EQUIPMENT
  LABOR
  OTHER
  MATERIAIS_INSUMOS
  SERVICOS_MAO_DE_OBRA
  GASTOS_PESSOAL
  DESPESAS_OPERACIONAIS
  INVESTIMENTOS
  DEPRECIACAO
  OUTRAS_DESPESAS
  DEDUCOES
  IMPOSTOS
}

enum TransactionStatus {
  PAID
  PENDING
  LATE
}

enum AlertSeverity {
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACK
}

enum PaymentStatus {
  CONFIRMADO
  PENDENTE
}

enum NeedPriority {
  ALTA
  MEDIA
  BAIXA
}

enum NeedStatus {
  PENDING
  IN_QUOTATION
  ORDERED
  EM_ANALISE
  APPROVED
  REJECTED
  PAID
}

enum PaymentCategory {
  MATERIAL
  SERVICO
  MAO_DE_OBRA
  EQUIPAMENTO
  TRANSPORTE
  ADMINISTRATIVO
  OUTRO
}

enum CostPayStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

enum DeliveryStatus {
  PENDENTE
  RECEBIDO
  ATRASADO
}

enum CertificationStatus {
  PENDENTE
  CONFORME
  DIVERGENTE
}

enum DailyPlanStatus {
  DRAFT
  PENDING_MATERIAL
  IN_PROGRESS
  PENDING_VALIDATION
  PENDING_RETURN
  COMPLETED
}

model DailyPlan {
  id                 String          @id @default(cuid())
  projectId          String
  date               DateTime
  status             DailyPlanStatus @default(DRAFT)
  description        String?
  receivedBy         String?
  technicianReceived Boolean         @default(false)
  returnedBy         String?
  returnConfirmedAt  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     DailyPlanTask[]
  materials DailyPlanMaterial[]
}

model DailyPlanTask {
  id             String  @id @default(cuid())
  dailyPlanId    String
  progressTaskId String
  plannedQty     Decimal @db.Decimal(18, 10)
  executedQty    Decimal @default(0) @db.Decimal(18, 10)
  notes          String?
  technicianId   String?

  dailyPlan    DailyPlan           @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  progressTask ProjectProgressTask @relation(fields: [progressTaskId], references: [id], onDelete: Cascade)
  technician   User?               @relation(fields: [technicianId], references: [id], onDelete: SetNull)
}

model DailyPlanMaterial {
  id           String  @id @default(cuid())
  dailyPlanId  String
  productId    String
  requestedQty Decimal @db.Decimal(16, 4)
  providedQty  Decimal @default(0) @db.Decimal(16, 4)
  consumedQty  Decimal @default(0) @db.Decimal(16, 4)

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model ProjectMaterialPlan {
  id         String  @id @default(cuid())
  projectId  String
  productId  String
  plannedQty Decimal @default(0) @db.Decimal(16, 4)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([projectId, productId])
}

// =============================================
// MÓDULO: CENTRO DE CUSTOS
// =============================================

model CostCenter {
  id            String               @id @default(cuid())
  projectId     String
  code          String
  name          String
  currency      String               @default("AOA")
  active        Boolean              @default(true)
  requiresQuotation Boolean          @default(true)
  createdAt     DateTime             @default(now())
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  needs         WorkNeed[]
  payments      CostPayment[]
  transactions  ProjectTransaction[]
  extraRequests ExtraRequest[]
  freightAllocations FreightAllocation[]

  @@unique([projectId, code])
  @@index([projectId])
}

model WorkNeed {
  id                String               @id @default(cuid())
  projectId         String
  costCenterId      String
  budgetLineId      String?
  date              DateTime             @default(now())
  description       String
  quantity          Decimal?             @db.Decimal(16, 4)
  unit              String?
  unitPrice         Decimal?             @db.Decimal(16, 4)
  originalUnitPrice Decimal?             @db.Decimal(16, 4)
  priceExceptionReason String?
  priceExceptionBy     String?
  priceExceptionAt     DateTime?
  hours             Decimal?             @db.Decimal(16, 4)
  priority          NeedPriority         @default(MEDIA)
  status            NeedStatus           @default(PENDING)
  scheduled         Boolean              @default(false)
  siteReceivedAt    DateTime?
  siteReceivedBy    String?
  siteReceivedNotes String?
  responsible       String?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenter        CostCenter           @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  budgetLine        ProjectBudgetLine?   @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  payments          CostPayment[]
  quotes            NeedQuote[]
  installments      PaymentInstallment[]

  @@index([projectId, costCenterId])
  @@index([budgetLineId])
}

model CostPayment {
  id                 String              @id @default(cuid())
  projectId          String
  costCenterId       String
  needId             String?
  supplierId         String?
  docNumber          String?
  paymentDate        DateTime
  supplier           String?
  category           PaymentCategory     @default(MATERIAL)
  description        String
  budgetedAmount     Decimal             @db.Decimal(16, 2)
  paidAmount         Decimal             @db.Decimal(16, 2)
  grossAmount        Decimal?            @db.Decimal(16, 2)
  vatAmount          Decimal?            @db.Decimal(16, 2)
  withholdingAmount  Decimal?            @db.Decimal(16, 2)
  netAmount          Decimal?            @db.Decimal(16, 2)
  fiscalApplyVat         Boolean         @default(false)
  fiscalApplyWithholding Boolean         @default(false)
  fiscalApplyDiscount    Boolean         @default(false)
  fiscalInputMode        String?         // "base" | "gross"
  paymentMethod      String?
  paymentType        String?             @default("PRONTO_PAGAMENTO")
  week               String?
  installment        Int?
  status             CostPayStatus       @default(PENDENTE)
  notes              String?
  comprovativoUrl    String?
  faturaUrl          String?
  certificationStatus CertificationStatus @default(PENDENTE)
  certifiedBy        String?
  certifiedAt        DateTime?
  certificationNotes String?
  createdAt          DateTime            @default(now())
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenter         CostCenter          @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  need               WorkNeed?           @relation(fields: [needId], references: [id], onDelete: SetNull)
  supplierRef        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentInstallment PaymentInstallment?
  freightOrder       FreightOrder?

  @@index([supplierId])
  @@index([projectId, costCenterId])
  @@index([projectId, paymentDate])
  @@index([certificationStatus])
}

// =============================================
// MÓDULO: FUNDO DE MANEIO & PEDIDOS EXTRA (Fase 7/8)
// =============================================

enum FundMovementType {
  CREDITO // reforço de saldo
  DEBITO // utilização (ex.: Pedido Extra)
  AJUSTE // correcção manual auditada
}

enum ExtraRequestType {
  OBRA // vinculado a uma obra específica
  GERAL // sem vínculo obrigatório a uma obra
}

enum ExtraPaymentSource {
  CAIXA
  BANCO
  FUNDO_MANEIO
  SOLICITACAO_TRANSFERENCIA // pedido de transferência bancária (substitui BANCO nos novos pedidos)
}

enum ExtraRequestStatus {
  PENDENTE
  APROVADO
  REJEITADO
  PAGO
  CANCELADO
}

// O Fundo de Maneio representa um saldo disponível (não é um custo).
// Pode existir por obra ou, quando projectId é nulo, como fundo geral.
model PettyCashFund {
  id             String   @id @default(cuid())
  projectId      String?
  name           String
  currency       String   @default("AOA")
  initialBalance Decimal  @default(0) @db.Decimal(16, 2)
  currentBalance Decimal  @default(0) @db.Decimal(16, 2)
  active         Boolean  @default(true)
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project               Project?                        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cards                 PettyCashCard[]
  movements             PettyCashMovement[]
  extraRequests         ExtraRequest[]
  reinforcementRequests PettyCashReinforcementRequest[]

  @@index([projectId])
}

enum PettyCashCardType {
  PREPAGO
  DEBITO
  CREDITO
}

// Cartões associados a um Fundo de Maneio (Cartão 1, Cartão 2...).
// Cada cartão tem saldo próprio — o saldo do fundo é o agregado dos cartões.
model PettyCashCard {
  id               String            @id @default(cuid())
  fundId           String
  label            String
  lastDigits       String?
  // Registo completo do cartão.
  cardNumberMasked String?
  bank             String?
  holderName       String?
  type             PettyCashCardType @default(PREPAGO)
  issuedAt         DateTime?
  expiresAt        DateTime?
  limitAmount      Decimal?          @db.Decimal(16, 2)
  responsibleName  String?
  initialBalance   Decimal           @default(0) @db.Decimal(16, 2)
  currentBalance   Decimal           @default(0) @db.Decimal(16, 2)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())

  fund                  PettyCashFund                   @relation(fields: [fundId], references: [id], onDelete: Cascade)
  movements             PettyCashMovement[]
  extraRequests         ExtraRequest[]
  reinforcementRequests PettyCashReinforcementRequest[]

  @@index([fundId])
}

// Histórico auditável de todas as movimentações de um Fundo de Maneio.
model PettyCashMovement {
  id             String           @id @default(cuid())
  fundId         String
  cardId         String?
  type           FundMovementType
  amount         Decimal          @db.Decimal(16, 2)
  balanceAfter   Decimal          @db.Decimal(16, 2)
  description    String
  extraRequestId String?          @unique
  createdBy      String?
  createdAt      DateTime         @default(now())

  fund                 PettyCashFund                  @relation(fields: [fundId], references: [id], onDelete: Cascade)
  card                 PettyCashCard?                 @relation(fields: [cardId], references: [id], onDelete: SetNull)
  extraRequest         ExtraRequest?                  @relation(fields: [extraRequestId], references: [id], onDelete: SetNull)
  reinforcementRequest PettyCashReinforcementRequest?

  @@index([fundId, createdAt])
  @@index([cardId])
}

enum ReinforcementStatus {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

// Pedido de Reforço de Fundo de Maneio: um reforço só entra em vigor (e só
// se torna um PettyCashMovement CREDITO real) depois de aprovado. Enquanto
// pendente, não altera nenhum saldo — espelha o fluxo de ExtraRequest, mas
// na direção contrária (entrada de fundo, não saída).
model PettyCashReinforcementRequest {
  id             String              @id @default(cuid())
  fundId         String
  cardId         String?
  amount         Decimal             @db.Decimal(16, 2)
  reason         String
  status         ReinforcementStatus @default(PENDENTE)
  requestedBy    String?
  requestedAt    DateTime            @default(now())
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  movementId     String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  fund     PettyCashFund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  card     PettyCashCard?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  movement PettyCashMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@index([fundId, status])
  @@index([cardId])
}

// Centros de custo gerais (fora do planeamento de obra).
model GeneralCostCenter {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  extraRequests ExtraRequest[]

  @@index([active])
}

// Pedido Extra: da Obra (vinculado) ou Geral (sem vínculo obrigatório).
// Pode ser pago via Caixa, Banco ou débito num Fundo de Maneio.
model ExtraRequest {
  id                  String             @id @default(cuid())
  type                ExtraRequestType   @default(OBRA)
  projectId           String?
  costCenterId        String?
  generalCostCenterId String?
  description    String
  amount         Decimal            @db.Decimal(16, 2)
  currency       String             @default("AOA")
  paymentSource  ExtraPaymentSource @default(CAIXA)
  fundId         String?
  cardId         String?
  status         ExtraRequestStatus @default(PENDENTE)
  requestedBy    String?
  requestedAt    DateTime           @default(now())
  paymentDueDate DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  paidBy         String?
  paidAt         DateTime?
  notes          String?
  proformaUrl    String?
  comprovativoUrl String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  costCenter        CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  generalCostCenter GeneralCostCenter? @relation(fields: [generalCostCenterId], references: [id], onDelete: SetNull)
  fund              PettyCashFund?     @relation(fields: [fundId], references: [id], onDelete: SetNull)
  card              PettyCashCard?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  movement          PettyCashMovement?

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([fundId])
  @@index([generalCostCenterId])
}

model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  userEmail String?
  action    String
  module    String
  status    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
}

model Supplier {
  id                 String       @id @default(cuid())
  name               String
  type               SupplierType @default(MATERIAL)
  nif                String?
  contact            String?
  phone              String?
  email              String?
  address            String?
  category           String?
  iban               String?
  paymentTerm        String?
  vatPercent         Decimal? @db.Decimal(5, 2) // % IVA — informativo, não altera orçamento base
  withholdingPercent Decimal? @db.Decimal(5, 2) // % Retenção na fonte
  discountPercent    Decimal? @db.Decimal(5, 2) // % Desconto
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products     SupplierProduct[]
  quotes       NeedQuote[]
  bankAccounts SupplierBankAccount[]
  payments     CostPayment[]
  freightOrders FreightOrder[]
}

enum SupplierType {
  MATERIAL
  SERVICO
  TRANSPORTADOR
}

enum FreightStatus {
  PENDENTE
  EM_ANALISE
  APPROVED
  PAGO
  CANCELADO
}

model FreightOrder {
  id            String         @id @default(cuid())
  supplierId    String
  totalAmount   Decimal        @db.Decimal(16, 2)
  currency      String         @default("AOA")
  status        FreightStatus  @default(PENDENTE)
  notes         String?
  costPaymentId String?        @unique
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  costPayment  CostPayment?        @relation(fields: [costPaymentId], references: [id], onDelete: SetNull)
  allocations  FreightAllocation[]

  @@index([supplierId])
  @@index([status])
}

model FreightAllocation {
  id             String   @id @default(cuid())
  freightOrderId String
  needQuoteId    String?
  projectId      String
  costCenterId   String?
  description    String
  amount         Decimal  @db.Decimal(16, 2)
  createdAt      DateTime @default(now())

  freightOrder FreightOrder @relation(fields: [freightOrderId], references: [id], onDelete: Cascade)
  needQuote    NeedQuote?   @relation(fields: [needQuoteId], references: [id], onDelete: SetNull)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([freightOrderId])
  @@index([projectId])
  @@index([needQuoteId])
}

model SupplierBankAccount {
  id         String   @id @default(cuid())
  supplierId String
  bankName   String
  iban       String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierProduct {
  id          String    @id @default(cuid())
  supplierId  String
  name        String
  description String?
  unit        String?
  price       Decimal   @db.Decimal(16, 4)
  currency    String    @default("AOA")
  vatPercent         Decimal? @db.Decimal(5, 2)
  withholdingPercent Decimal? @db.Decimal(5, 2)
  discountPercent    Decimal? @db.Decimal(5, 2)
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quotes   NeedQuote[]
}

model NeedQuote {
  id                String    @id @default(cuid())
  needId            String
  supplierId        String
  supplierProductId String?
  quotedPrice       Decimal   @db.Decimal(16, 4)
  quantity          Decimal?  @db.Decimal(16, 4)
  totalValue        Decimal?  @db.Decimal(16, 4)
  currency          String    @default("AOA")
  selected          Boolean   @default(false)
  notes             String?
  proformaUrl       String?
  purchaseOrderUrl  String?
  orderNumber       Int?      @unique
  poDocumentId      String?
  poIssuedBy        String?
  poIssuedAt        DateTime?

  // Crédito — preenchido apenas quando a condição de pagamento do fornecedor é "Crédito"
  creditTermDays      Int?
  expectedReceiptDate DateTime?
  installmentsPlanned Int?
  invoiceConfirmedAt  DateTime?
  invoiceConfirmedBy  String?
  receivedAt          DateTime?
  deliveryStatus      DeliveryStatus @default(PENDENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  need            WorkNeed             @relation(fields: [needId], references: [id], onDelete: Cascade)
  supplier        Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct?     @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  installments    PaymentInstallment[]
  stockMovements  StockMovement[]
  freightAllocations FreightAllocation[]
}

enum InstallmentStatus {
  PENDENTE
  VENCIDO
  PAGO
  CANCELADO
}

// Plano de parcelas gerado automaticamente após a confirmação da fatura de uma
// encomenda a crédito. Cada parcela também é espelhada num CostPayment (via
// costPaymentId) para continuar a aparecer nos ecrãs de Cronograma/Pagamentos
// já existentes, sem duplicar lógica de apresentação.
model PaymentInstallment {
  id            String            @id @default(cuid())
  quoteId       String
  needId        String
  costPaymentId String?           @unique
  number        Int
  amount        Decimal           @db.Decimal(16, 2)
  currency      String            @default("AOA")
  dueDate       DateTime
  paidDate      DateTime?
  status        InstallmentStatus @default(PENDENTE)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  quote       NeedQuote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  need        WorkNeed                    @relation(fields: [needId], references: [id], onDelete: Cascade)
  costPayment CostPayment?                @relation(fields: [costPaymentId], references: [id], onDelete: SetNull)
  history     PaymentInstallmentHistory[]

  @@index([needId])
  @@index([quoteId])
  @@index([dueDate])
  @@index([status])
}

model PaymentInstallmentHistory {
  id            String   @id @default(cuid())
  installmentId String
  action        String
  fromValue     String?
  toValue       String?
  userId        String?
  userName      String?
  createdAt     DateTime @default(now())

  installment PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
}
